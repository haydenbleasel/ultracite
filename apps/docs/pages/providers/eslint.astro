---
import { hooks } from "../../../../packages/cli/src/data/hooks";
import Cta from "../../components/home/cta.astro";
import Faq from "../../components/landing/faq.astro";
import LandingHero from "../../components/landing/landing-hero.astro";
import LandingLayout from "../../components/landing/landing-layout.astro";
import type {
  Crumb,
  Faq as FaqItem,
} from "../../components/landing/landing-layout.astro";
import NextSteps from "../../components/landing/next-steps.astro";
import type { NextStep } from "../../components/landing/next-steps.astro";
import ConfigFiles from "../../components/providers/eslint/config-files.astro";
import Coverage from "../../components/providers/eslint/coverage.astro";
import Everywhere from "../../components/providers/eslint/everywhere.astro";
import Formatter from "../../components/providers/eslint/formatter.astro";
import Frameworks from "../../components/providers/eslint/frameworks.astro";
import Speed from "../../components/providers/eslint/speed.astro";
import {
  eslintSingleFileMs,
  eslintTypeAwareMs,
  formatMs,
  runFor,
} from "../../lib/benchmarks";
import { providerLogos } from "../../lib/logos";

// Facts on this page were checked against ESLint 10.12.0, Prettier 3.9.10,
// Stylelint 17.16.0 and Ultracite 8.0.0 (packed from main at ed5ed04d, before
// it was published) on this date.
const lastModified = "2026-10-10";
const command = "npx ultracite@latest init --linter eslint";
const small = runFor(42);
const large = runFor(420);

const breadcrumbs: Crumb[] = [
  { href: "/providers", name: "Providers" },
  { href: "/providers/eslint", name: "ESLint" },
];

const faqs: FaqItem[] = [
  {
    answer:
      "ESLint runs no rules until you configure it. Ultracite’s core preset turns on 918 across ESLint and ten plugins, among them typescript-eslint, Unicorn, SonarJS and import-x. Framework presets add more: 549 rules for React, 47 for Next.js and 208 for Vue. The opt-in type-aware preset adds 100 rules that read your types. `init` also writes Prettier and Stylelint configs, editor settings for VS Code and Zed, `AGENTS.md` for coding agents, and optional post-edit hooks.",
    question: "What does Ultracite add on top of ESLint?",
  },
  {
    answer:
      'Add a config object after the presets in `eslint.config.mjs`, such as `{ rules: { "no-console": "off" } }`. In a flat config, later objects win. For one line, use `// eslint-disable-next-line no-console`.',
    question: "How do I turn off a rule?",
  },
  {
    answer: `ESLint and its plugins run in Node, and Prettier and Stylelint run as steps of their own. In our benchmark the toolchain checked 42 files in ${formatMs(small.ms.eslint)} and 420 files in ${formatMs(large.ms.eslint)}, where Oxlint took ${formatMs(small.ms.oxlint)} and ${formatMs(large.ms.oxlint)}. Checking the single file an agent edited took ${formatMs(eslintSingleFileMs)}. The type-aware preset adds TypeScript’s type checker, which took the 420 files to ${formatMs(eslintTypeAwareMs)}.`,
    question: "Why is it slower than Oxlint and Biome?",
  },
  {
    answer:
      "When you depend on something only ESLint has: a plugin with no native port, a Prettier plugin, or template linting for Vue, Svelte and Astro through each framework’s own parser. Otherwise start with Oxlint, which keeps ESLint’s rule names and runs ESLint plugins through its JS plugin API.",
    question: "When should I pick ESLint over Oxlint or Biome?",
  },
  {
    answer:
      "Not for the core preset, which lints TypeScript from its syntax alone. The type-aware preset does: its rules use `projectService`, which finds the `tsconfig.json` that includes each file, and a `.ts` or `.tsx` file that no `tsconfig.json` includes fails with a parsing error. `init --type-aware` adds the preset and offers to turn on `strictNullChecks`, which some of its rules need.",
    question: "Do I need a tsconfig.json?",
  },
  {
    answer:
      "ESLint lints JavaScript and TypeScript modules (`.js`, `.jsx`, `.mjs`, `.cjs`, `.ts`, `.tsx`, `.mts`, `.cts`) and inline scripts in HTML files, and the Vue, Svelte and Astro presets add their components. It doesn’t lint JSON, which Prettier formats. Stylelint lints `.css`, `.scss` and `.less`, extending `stylelint-config-standard` and `stylelint-config-idiomatic-order`, reads SCSS and Less through the `postcss-scss` and `postcss-less` syntaxes `init` installs, and accepts Tailwind v4’s at-rules, functions and theme variables.",
    question: "Which files does it lint?",
  },
  {
    answer:
      "Yes. `prettier.config.mjs` is an ordinary Prettier config that spreads Ultracite’s settings, so add plugins to its `plugins` array. `init` puts `prettier-plugin-tailwindcss` there, and `prettier-plugin-svelte` or `prettier-plugin-astro` before it when you pick those frameworks. Keep the Tailwind plugin last, as its docs require.",
    question: "Can I use Prettier plugins?",
  },
];

const nextSteps: NextStep[] = [
  {
    description: "Framework presets, type-aware rules and overriding rules.",
    href: "/docs/configuration",
    label: "Reference",
    title: "Configuration",
  },
  {
    description:
      "The same standard on a native engine, with ESLint’s rule names.",
    href: "/providers/oxlint",
    label: "Provider",
    title: "Ultracite for Oxlint",
  },
  {
    description: `Run \`ultracite fix\` on just the file your agent edited, in ${hooks.length} agents and editors.`,
    href: "/docs/ai/hooks",
    label: "Guide",
    title: "Agent hooks",
  },
  {
    description:
      "Oxlint, Biome and ESLint side by side: rules, speed, tradeoffs.",
    href: "/providers",
    label: "Providers",
    title: "Compare the engines",
  },
];
---

<LandingLayout
  breadcrumbs={breadcrumbs}
  description="Ultracite turns on 918 rules across ESLint and ten plugins, sets up Prettier and Stylelint, and adds presets for 15 frameworks."
  faqs={faqs}
  lastModified={lastModified}
  title="Ultracite for ESLint — Strict ESLint, Prettier and Stylelint"
>
  <LandingHero
    breadcrumbs={breadcrumbs}
    command={command}
    logo={providerLogos.eslint}
    name="ESLint"
    title="ESLint, Prettier and Stylelint, set up as one"
  >
    Ultracite turns on 918 rules from ESLint and ten plugins, then sets up
    Prettier and Stylelint to match. Three short config files extend
    Ultracite’s, so the only rules you maintain are your own.
    <Fragment slot="note">
      <span>Also on</span>
      <a
        class="hover:text-foreground underline underline-offset-2"
        href="/providers/oxlint"
      >
        Oxlint
      </a>
      <a
        class="hover:text-foreground underline underline-offset-2"
        href="/providers/biome"
      >
        Biome
      </a>
      <span aria-hidden="true">·</span>
      <span>Checked against ESLint 10.12</span>
    </Fragment>
    <ConfigFiles slot="visual" />
  </LandingHero>
  <Coverage />
  <Frameworks />
  <Formatter />
  <Speed />
  <Everywhere />
  <Faq id="es-faq" items={faqs} title="ESLint questions, answered" />
  <NextSteps id="es-next" items={nextSteps} title="Keep going" />
  <Cta command={command} />
</LandingLayout>
