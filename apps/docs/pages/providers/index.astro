---
import Cta from "../../components/home/cta.astro";
import Icon from "../../components/home/icon.astro";
import Installer from "../../components/home/installer.astro";
import SectionHeading from "../../components/home/section-heading.astro";
import Faq from "../../components/landing/faq.astro";
import LandingLayout from "../../components/landing/landing-layout.astro";
import type { Crumb, Faq as FaqItem } from "../../components/landing/landing-layout.astro";
import RichText from "../../components/landing/rich-text.astro";
import {
  benchmarkMachine,
  formatMs,
  runFor,
  toolchainVersions,
} from "../../lib/benchmarks";
import { providerLogos } from "../../lib/logos";
import type { ProviderId } from "../../lib/providers";

const lastModified = "2026-10-14";

const breadcrumbs: Crumb[] = [{ href: "/providers", name: "Providers" }];

const hrefFor = (id: ProviderId): string => `/providers/${id}`;

// Rules on in each core preset (Ultracite 8.0.0): Oxlint's set to "error",
// Biome's from `biome rage --linter`, and ESLint's from `eslint
// --print-config` on a TypeScript file. Bun's are Oxlint's core as
// ultracite/bun's defineConfig passes it on, set to "error" (Ultracite 8.0.1
// with the Bun provider: the 19 jsdoc rules left out, and the same 455 that
// `bun lint --print-config` reports). Rules that read types: Oxlint's
// type-aware rules in core, which Bun runs too; Biome's type-aware preset;
// for ESLint, the 100 rules ultracite/eslint/type-aware adds plus the 32
// SonarJS rules in core that use types when there are some. Times are from
// lib/benchmarks.
const small = runFor(42);
const large = runFor(420);

const engines = [
  {
    check420: formatMs(large.ms.oxlint),
    coreRules: 474,
    id: "oxlint",
    name: "Oxlint + Oxfmt",
    recommended: true,
    summary:
      "The Oxc project’s Rust linter and formatter, with ESLint’s rule names and an API for ESLint plugins.",
  },
  {
    check420: formatMs(large.ms.biome),
    coreRules: 331,
    id: "biome",
    name: "Biome",
    recommended: false,
    summary:
      "One Rust binary that lints and formats from a single config file, with its own rule set.",
  },
  {
    check420: formatMs(large.ms.eslint),
    coreRules: 918,
    id: "eslint",
    name: "ESLint + Prettier + Stylelint",
    recommended: false,
    summary:
      "The JavaScript toolchain most projects started on, with every plugin ever written for it.",
  },
  {
    check420: formatMs(large.ms.bun),
    coreRules: 455,
    id: "bun",
    name: "Bun",
    recommended: false,
    summary:
      "The linter and formatter built into Bun, which run Oxlint’s rules and Oxfmt’s formatting natively.",
  },
] satisfies {
  check420: string;
  coreRules: number;
  id: ProviderId;
  name: string;
  recommended: boolean;
  summary: string;
}[];

const rows: { label: string; values: [string, string, string, string] }[] = [
  {
    label: "Runs on",
    values: [
      "Native Rust binaries",
      "One native Rust binary",
      "Node.js",
      "Bun 1.4.4 or later, with nothing else to install",
    ],
  },
  { label: "Rules on in the core preset", values: ["474", "331", "918", "455"] },
  {
    label: "`ultracite check`, 42 files",
    values: [
      formatMs(small.ms.oxlint),
      formatMs(small.ms.biome),
      formatMs(small.ms.eslint),
      formatMs(small.ms.bun),
    ],
  },
  {
    label: "`ultracite check`, 420 files",
    values: [
      formatMs(large.ms.oxlint),
      formatMs(large.ms.biome),
      formatMs(large.ms.eslint),
      formatMs(large.ms.bun),
    ],
  },
  {
    label: "Rules that read types",
    values: [
      "56, opt-in at setup",
      "7 project-wide rules, opt-in at setup",
      "132, opt-in at setup",
      "Oxlint’s 56, opt-in at setup, with types from `bun check`",
    ],
  },
  {
    label: "ESLint plugins",
    values: [
      "Opt-in, through JS plugins",
      "No",
      "Any of them",
      "Opt-in, through the same JS plugins",
    ],
  },
  {
    label: "Formatter",
    values: ["Oxfmt", "Biome", "Prettier, with its plugins", "`bun fmt`, which prints what Oxfmt prints"],
  },
  {
    label: "Editor support",
    values: [
      "Oxc extension",
      "Biome extension",
      "ESLint, Prettier and Stylelint extensions",
      "Oxc extension, running Oxlint and Oxfmt on the same configs",
    ],
  },
  {
    label: "Files `init` writes",
    values: [
      "`oxlint.config.ts`, `oxfmt.config.ts`",
      "`biome.jsonc`",
      "`eslint.config.mjs`, `prettier.config.mjs`, `stylelint.config.mjs`",
      "`oxlint.config.ts`, `oxfmt.config.ts`",
    ],
  },
  {
    label: "Pick it for",
    values: [
      "Speed and breadth together: the default for new projects",
      "One tool and one config file that lints, formats and sorts",
      "Template linting in Vue and Svelte, Prettier plugins, niche ESLint plugins",
      "Projects on Bun that want Oxlint’s rules without the Oxc packages",
    ],
  },
];

const faqs: FaqItem[] = [
  {
    answer:
      "Start with Oxlint. It’s what `init` recommends: native speed, 474 rules in the core preset, ESLint’s rule names and type-aware rules on typescript-go. Pick Biome if you want one tool and one config file that lints, formats and sorts. Pick ESLint if you depend on an ESLint or Prettier plugin, or need Vue and Svelte templates linted. Pick Bun if your project runs on a Bun that has `bun lint` and `bun fmt` and you’d rather not install the Oxc packages: it runs the same configs as Oxlint.",
    question: "Which engine should I pick?",
  },
  {
    answer:
      "Yes. Run `npx ultracite init --linter biome` (or `oxlint`, `eslint` or `bun`). `init` removes the packages and config files it installed for the old engine, writes the new engine’s config, and merges into your `.vscode/settings.json` instead of replacing it. Oxlint and Bun share their config files, so moving between those two only changes where `defineConfig` is imported from.",
    question: "Can I switch engines later?",
  },
  {
    answer:
      "They aim at the same standard: type safety, React and hooks, accessibility, async code and imports. Names differ by engine (`noExplicitAny` in Biome, `no-explicit-any` in Oxlint and ESLint), and ESLint turns on the most rules because the most plugins exist for it. Bun runs Oxlint’s presets, minus the `jsdoc/*` and `vue/*` rules it doesn’t implement.",
    question: "Do all four enforce the same rules?",
  },
  {
    answer:
      `On a small project, yes: Biome checked 42 files in ${formatMs(small.ms.biome)} and Oxlint with Oxfmt in ${formatMs(small.ms.oxlint)}, because Biome lints and formats in one process while \`ultracite check\` on Oxlint runs Oxlint and then Oxfmt. At 420 files Oxlint was slightly ahead, ${formatMs(large.ms.oxlint)} to Biome’s ${formatMs(large.ms.biome)}. The ESLint toolchain went from ${formatMs(small.ms.eslint)} to ${formatMs(large.ms.eslint)}.`,
    question: "Is Biome faster than Oxlint?",
  },
];
---

<LandingLayout
  breadcrumbs={breadcrumbs}
  description="Ultracite configures Oxlint + Oxfmt, Biome, ESLint + Prettier + Stylelint or Bun with the same strict standard. Compare their rules, speed and tradeoffs."
  faqs={faqs}
  lastModified={lastModified}
  title="Ultracite Providers — Oxlint, Biome, ESLint and Bun Compared"
>
  <section class="border-border border-y">
    <div class="hp-frame mx-auto max-w-7xl border-border border-x">
      <div class="px-4 pt-10 pb-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16 lg:pb-14">
        <p class="font-mono text-muted-foreground text-xs/5">Providers</p>
        <h1
          class="mt-10 max-w-[16ch] text-balance font-medium text-5xl tracking-[-0.045em] sm:text-6xl lg:mt-12 lg:text-7xl"
        >
          One standard, four engines
        </h1>
        <div
          class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-12 lg:items-end lg:gap-10"
        >
          <p
            class="max-w-[48ch] text-pretty text-lg/8 text-muted-foreground lg:col-span-6"
          >
            Ultracite is a preset, not a linter. It sets up the toolchain you
            pick with the same strict rules, editor settings and agent
            instructions, and you can switch engines with one command.
          </p>
          <div class="flex flex-col gap-3 lg:col-span-6 lg:items-end">
            <Installer />
          </div>
        </div>
      </div>
      <div class="border-border border-t bg-signal p-2 sm:p-6 lg:p-10">
        <ul class="grid gap-2 sm:gap-4 md:grid-cols-2" role="list">
          {
            engines.map((engine) => (
              <li class="flex">
                <a
                  class="group flex w-full flex-col gap-6 rounded-blume border border-border bg-code p-6 hover:border-foreground/30 sm:p-8"
                  href={hrefFor(engine.id)}
                >
                  <span class="flex items-center justify-between gap-4">
                    <img
                      alt=""
                      class="size-9 rounded-md"
                      height="36"
                      src={providerLogos[engine.id]}
                      width="36"
                    />
                    {engine.recommended && (
                      <span class="rounded-sm bg-foreground px-1.5 py-0.5 font-mono text-background text-xs/5">
                        Recommended
                      </span>
                    )}
                  </span>
                  <span class="flex flex-col gap-2">
                    <span class="font-medium text-2xl tracking-[-0.02em]">
                      {engine.name}
                    </span>
                    <span class="text-pretty text-[15px]/6 text-muted-foreground">
                      {engine.summary}
                    </span>
                  </span>
                  <span class="mt-auto grid grid-cols-2 gap-4 border-border border-t pt-5">
                    <span class="flex flex-col gap-1">
                      <span class="font-medium text-2xl tabular-nums tracking-[-0.02em]">
                        {engine.coreRules.toLocaleString("en-US")}
                      </span>
                      <span class="text-muted-foreground text-sm/5">core rules</span>
                    </span>
                    <span class="flex flex-col gap-1">
                      <span class="font-medium text-2xl tabular-nums tracking-[-0.02em]">
                        {engine.check420}
                      </span>
                      <span class="text-muted-foreground text-sm/5">to check 420 files</span>
                    </span>
                  </span>
                  <span class="flex items-center gap-2 font-medium text-[15px]/6">
                    Ultracite for {engine.name.split(" ")[0]}
                    <Icon
                      class="size-4 transition-transform group-hover:translate-x-0.5"
                      name="arrow-right"
                    />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section aria-labelledby="pv-compare" class="border-border border-b">
    <div class="hp-frame mx-auto max-w-7xl border-border border-x">
      <SectionHeading id="pv-compare" title="Side by side">
        The same project, the same machine, each engine through Ultracite’s
        core preset.
      </SectionHeading>
      <div class="overflow-x-auto border-border border-t">
        <table class="w-full min-w-[68rem] border-collapse text-left text-[15px]/6">
          <thead>
            <tr class="border-border border-b">
              <th class="w-[18%] px-4 py-4 font-normal text-muted-foreground sm:px-6 lg:px-10" scope="col">
                <span class="sr-only">Property</span>
              </th>
              {
                engines.map((engine) => (
                  <th class="w-[20.5%] px-4 py-4 font-medium sm:px-6" scope="col">
                    <span class="flex items-center gap-2.5">
                      <img alt="" class="size-5 rounded-[3px]" height="20" src={providerLogos[engine.id]} width="20" />
                      {engine.name}
                    </span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr class="border-border border-b last:border-b-0">
                  <th class="px-4 py-4 align-top font-normal text-muted-foreground sm:px-6 lg:px-10" scope="row">
                    <RichText text={row.label} />
                  </th>
                  {row.values.map((value) => (
                    <td class="text-pretty px-4 py-4 align-top tabular-nums sm:px-6">
                      <RichText text={value} />
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p
        class="text-pretty border-border border-t px-4 py-5 text-muted-foreground text-sm/6 sm:px-6 lg:px-10"
      >
        Ultracite 8.0.1, with the Bun provider. Times are medians of five runs
        of <code class="font-mono text-[13px]">ultracite check</code> on{" "}
        {benchmarkMachine} over the repo’s benchmark fixture, with{" "}
        {toolchainVersions.oxlint}; {toolchainVersions.biome};{" "}
        {toolchainVersions.eslint}; and {toolchainVersions.bun}. They include
        starting Node and the CLI.
      </p>
    </div>
  </section>

  <Faq id="pv-faq" items={faqs} title="Choosing an engine" />
  <Cta />
</LandingLayout>
