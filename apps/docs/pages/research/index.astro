---
import data from "blume:data";

import BlogLayout from "../../components/blog/blog-layout.astro";
import RuleTags from "../../components/blog/rule-tags.astro";
import { isoDate, posts } from "../../lib/blog";
import type { JsonLdNode } from "../../lib/blog";

// Every post needs its own page to have a route (see lib/blog.ts), so a post
// without one fails the build here rather than linking to a 404.
const pages = import.meta.glob("./*.astro");
for (const post of posts) {
  if (!(`./${post.slug}.astro` in pages)) {
    throw new Error(
      `blog/${post.slug}.mdx has no page. Add pages/research/${post.slug}.astro; the comment at the top of lib/blog.ts shows what goes in it.`
    );
  }
}

const title = "Open research on code quality";
const description =
  "Research on the lint rules Ultracite turns on: what each one measures, what it means for the people and agents writing the code, and what it costs at scale.";

const siteUrl = data.config.site ?? "https://www.ultracite.ai";
const indexUrl = new URL("/research", siteUrl).href;

const jsonLd: JsonLdNode = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@id": `${indexUrl}#research`,
      "@type": "Blog",
      blogPost: posts.map((post) => ({
        "@type": "BlogPosting",
        author: { "@type": "Person", name: post.author.name },
        datePublished: isoDate(post.date),
        headline: post.title,
        url: new URL(post.href, siteUrl).href,
      })),
      description,
      inLanguage: "en",
      name: "Ultracite Research",
      publisher: { "@type": "Organization", name: "Ultracite", url: siteUrl },
      url: indexUrl,
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { item: siteUrl, name: "Home" },
        { item: indexUrl, name: "Research" },
      ].map((crumb, index) => ({
        "@type": "ListItem",
        ...crumb,
        position: index + 1,
      })),
    },
  ],
};
---

<BlogLayout
  description={description}
  jsonLd={jsonLd}
  title="Research — Ultracite"
>
  <section aria-labelledby="blog-title" class="border-border border-y">
    <div class="hp-frame border-border mx-auto max-w-7xl border-x">
      <div class="px-4 pt-10 pb-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16 lg:pb-14">
        <p class="text-muted-foreground font-mono text-xs/5">Research</p>
        <h1
          class="mt-10 max-w-[16ch] text-5xl font-medium tracking-[-0.045em] text-balance sm:text-6xl lg:mt-12 lg:text-7xl"
          id="blog-title"
        >
          {title}
        </h1>
        <p class="text-muted-foreground mt-10 max-w-[52ch] text-lg/8 text-pretty lg:mt-12">
          {description}
        </p>
      </div>
    </div>
  </section>

  <section aria-label="Posts" class="border-border border-b">
    <div class="hp-frame border-border mx-auto max-w-7xl border-x">
      {posts.length > 0 ? (
        <ol class="divide-border divide-y" role="list">
          {posts.map((post) => (
            <li>
              <a
                class="group hover:bg-muted/50 grid gap-4 px-4 py-8 sm:px-6 sm:py-10 lg:grid-cols-12 lg:gap-10 lg:px-10"
                href={post.href}
              >
                <p class="text-muted-foreground font-mono text-xs/5 lg:col-span-3 lg:pt-2">
                  {post.readingMinutes} min read
                </p>
                <div class="lg:col-span-6">
                  <h2 class="text-2xl font-medium tracking-[-0.03em] text-balance group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4 sm:text-3xl">
                    {post.title}
                  </h2>
                  <p class="text-muted-foreground mt-3 max-w-[60ch] text-[15px]/7 text-pretty">
                    {post.description}
                  </p>
                </div>
                <RuleTags
                  class="lg:col-span-3 lg:justify-end lg:pt-2"
                  rules={post.rules}
                />
              </a>
            </li>
          ))}
        </ol>
      ) : (
        <p class="text-muted-foreground px-4 py-16 sm:px-6 lg:px-10">
          The first post is on its way.
        </p>
      )}
    </div>
  </section>
</BlogLayout>
