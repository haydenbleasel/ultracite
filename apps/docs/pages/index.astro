---
import PageLayout from "blume/components/layout/PageLayout.astro";
import data from "blume:data";
import "../styles/home.css";

import AgentLoop from "../components/home/agent-loop.astro";
import Community from "../components/home/community.astro";
import Cta from "../components/home/cta.astro";
import Fast from "../components/home/fast.astro";
import Footer from "../components/home/footer.astro";
import Hero from "../components/home/hero.astro";
import Logos from "../components/home/logos.astro";
import Setup from "../components/home/setup.astro";
import Strict from "../components/home/strict.astro";
import { latestVersion } from "../lib/latest-version";

const { config } = data;
// blume.config.ts `description` is the single source for the homepage's meta
// description, llms.txt, and the docs pages' fallback. The hero writes its own
// subtitle for the agentic story.
const siteDescription = config.description ?? "";
---

<PageLayout
  analytics={config.analytics}
  appleIcon={config.appleIcon}
  banner={config.banner}
  favicon={config.favicon}
  fontCssVars={data.fontCssVars}
  logo={config.logo}
  navigation={data.navigation}
  ogEnabled={config.og.enabled}
  ogImage="/opengraph-image.png"
  ogImageAlt="The Ultracite logo over a painted seascape"
  ogImageSize={{ height: 630, width: 1200 }}
  page={{
    description: siteDescription,
    title: "Ultracite — Zero-Config Linting for Oxlint, Biome & ESLint",
  }}
  searchEnabled={config.search.enabled}
  site={{ title: config.title, description: siteDescription }}
  siteUrl={config.site}
  themeMode={config.theme.mode}
  x={config.x}
>
  <Hero version={latestVersion} />
  <Logos />
  <Strict />
  <Fast />
  <AgentLoop />
  <Setup />
  <Community />
  <Cta />
  <Footer slot="footer" />
</PageLayout>
