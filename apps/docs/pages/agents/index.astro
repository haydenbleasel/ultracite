---
import { agents as cliAgents } from "../../../../packages/cli/src/data/agents";
import Cta from "../../components/home/cta.astro";
import Icon from "../../components/home/icon.astro";
import Installer from "../../components/home/installer.astro";
import SectionHeading from "../../components/home/section-heading.astro";
import Faq from "../../components/landing/faq.astro";
import LandingLayout from "../../components/landing/landing-layout.astro";
import type {
  Crumb,
  Faq as FaqItem,
} from "../../components/landing/landing-layout.astro";
import RichText from "../../components/landing/rich-text.astro";
import { agentDirectory, agentGroups } from "../../lib/agent-directory";
import type { AgentEntry } from "../../lib/agent-directory";
import { hookIntegrations } from "../../lib/hooks";

const lastModified = "2026-10-10";

const breadcrumbs: Crumb[] = [{ href: "/agents", name: "Agents" }];

// An agent links to its landing page once pages/agents/<id>.astro exists.
const landingPages = import.meta.glob("./*.astro");

const hasLandingPage = (id: string): boolean => `./${id}.astro` in landingPages;

// The CLI's table decides which agents exist and what `init` writes for each;
// the directory adds who makes them and what they are. An agent the CLI adds
// before the directory catches up still shows, under its CLI name.
const directory = new Map<string, AgentEntry>(Object.entries(agentDirectory));

// Every agent gets AGENTS.md; these are the files `init` adds for one agent:
// the import, copy or settings file it needs to read the rules, and its hook.
const extrasFor = (agent: (typeof cliAgents)[number]) => [
  ...(agent.imports
    ? [{ path: agent.imports[0] ?? "CLAUDE.md", tag: "Import" }]
    : []),
  ...(agent.rulesCopy ? [{ path: agent.rulesCopy, tag: "Copy" }] : []),
  ...(agent.settings ? [{ path: agent.settings.path, tag: "Config" }] : []),
  ...(agent.hooks ? [{ path: agent.hooks.path, tag: "Hook" }] : []),
];

const entries = cliAgents.map((agent) => {
  const details = directory.get(agent.id);

  return {
    extras: extrasFor(agent),
    group: details?.group ?? "terminal",
    hook: agent.hooks?.path,
    id: agent.id,
    imports: Boolean(agent.imports),
    landing: hasLandingPage(agent.id),
    logo: `/logos/${details?.logo ?? agent.id}.svg`,
    maker: details?.maker,
    name: details?.name ?? agent.name,
    // Replit Agent reads only replit.md, which gets its own copy.
    readsAgentsFile: !agent.rulesCopy,
    // Reads AGENTS.md with no extra step.
    readsOnItsOwn: !(agent.imports || agent.rulesCopy || agent.settings),
    tagline: details?.tagline,
  };
});

const byName = (a: { name: string }, b: { name: string }): number =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base" });

// The frontier agents lead the page. Beyond the rules file and the hook,
// `ultracite fix --claude` and `--codex` hand whatever autofix can't
// settle to that agent's CLI (docs/usage.mdx).
const featuredFixFlags = new Map([
  ["claude", "--claude"],
  ["codex", "--codex"],
]);

const featured = entries.flatMap((entry) => {
  const fixFlag = featuredFixFlags.get(entry.id);

  return fixFlag ? [{ ...entry, fixFlag }] : [];
});

const groups = agentGroups
  .map((group) => ({
    ...group,
    entries: entries
      .filter(
        (entry) => entry.group === group.id && !featuredFixFlags.has(entry.id)
      )
      .toSorted(byName),
  }))
  .filter((group) => group.entries.length > 0);

// What `init` writes: AGENTS.md for every agent that reads it, then each
// agent's extras.
const agentsFileReaders = entries
  .filter((entry) => entry.readsAgentsFile)
  .toSorted(byName);

const extraFiles = entries.flatMap((entry) =>
  entry.extras.map((extra) => ({ ...extra, reader: entry }))
);

const onItsOwn = entries.filter((entry) => entry.readsOnItsOwn).length;
const STACK_SIZE = 9;

const hookNames = new Intl.ListFormat("en", {
  style: "long",
  type: "conjunction",
}).format(hookIntegrations.map((hook) => hook.name));

const faqs: FaqItem[] = [
  {
    answer: `\`AGENTS.md\`, for every agent. ${onItsOwn} of them read it on their own. Claude Code reads it through an \`@AGENTS.md\` import when your project has its own \`CLAUDE.md\`, Gemini CLI once \`.gemini/settings.json\` lists it, and Aider once \`.aider.conf.yml\` does; \`init\` sets each of those up. Replit Agent reads only \`replit.md\`, so it gets a copy of the rules there.`,
    question: "Which file does Ultracite write for my agent?",
  },
  {
    answer:
      "Ultracite adds its block, starting at `# Ultracite Code Standards`, below your own content. Running `init` again replaces that block in place and leaves the rest of the file alone.",
    question: "What happens to my existing AGENTS.md?",
  },
  {
    answer: `With \`--hooks\`, \`init\` sets up a hook that runs \`ultracite fix --hook\` on every file the agent edits, in ${hookNames}. Aider runs \`ultracite fix\` on each file it edits through the \`lint-cmd\` that \`init\` sets in \`.aider.conf.yml\`. For OpenCode, add the plugin from its page.`,
    question: "Which agents get checked after every edit?",
  },
  {
    answer:
      "Most likely. Nearly every coding agent reads `AGENTS.md` now, so `npx ultracite init --agents universal` covers it. If yours reads another file, copy the Ultracite block from `AGENTS.md` into it.",
    question: "My agent isn’t listed. Will Ultracite work with it?",
  },
  {
    answer:
      "`init` asks which agents you use. Pass `--agents` with one or more IDs, separated by spaces, to skip the prompts: `npx ultracite init --agents claude opencode`.",
    question: "How do I pick agents without the prompt?",
  },
  {
    answer:
      "Run `init` again and the rules move to `AGENTS.md`. `init` takes Ultracite’s block out of the files earlier versions wrote (`.claude/CLAUDE.md`, `GEMINI.md`, Firebender’s rule file and Aider’s `ultracite.md`), removes any file left with nothing else in it, and sets up the import or settings that agent needs to read `AGENTS.md`. Your own content in those files stays.",
    question:
      "I set Ultracite up before. What happens to CLAUDE.md and GEMINI.md?",
  },
];
---

<LandingLayout
  breadcrumbs={breadcrumbs}
  description={`Ultracite writes its rules to AGENTS.md, which ${entries.length} coding agents from Claude Code and Codex to OpenCode and Copilot read, and can lint every edit they make.`}
  faqs={faqs}
  lastModified={lastModified}
  title={`Ultracite for Coding Agents — ${entries.length} Agents, One Standard`}
>
  <section class="border-border border-y">
    <div class="hp-frame border-border mx-auto max-w-7xl border-x">
      <div class="px-4 pt-10 pb-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16 lg:pb-14">
        <p class="text-muted-foreground font-mono text-xs/5">Agents</p>
        <h1 class="mt-10 max-w-[17ch] text-5xl font-medium tracking-[-0.045em] text-balance sm:text-6xl lg:mt-12 lg:text-7xl">
          The same standard in every coding agent
        </h1>
        <div class="mt-10 grid gap-8 lg:mt-12 lg:grid-cols-12 lg:items-end lg:gap-10">
          <p class="text-muted-foreground max-w-[48ch] text-lg/8 text-pretty lg:col-span-6">
            <code class="text-foreground font-mono text-base">
              ultracite init
            </code>{" "}
            writes the rules into{" "}
            <code class="text-foreground font-mono text-base">AGENTS.md</code>,
            which coding agents read before they write a line, and for some adds
            a hook that checks every edit. {entries.length} agents, one command.
          </p>
          <div class="flex flex-col gap-3 lg:col-span-6 lg:items-end">
            <Installer />
          </div>
        </div>
      </div>
      <div class="border-border bg-signal border-t p-2 sm:p-6 lg:p-10">
        <figure class="rounded-blume border-border bg-code m-0 overflow-hidden border">
          <figcaption class="border-border text-muted-foreground flex h-11 items-center justify-between gap-4 border-b px-4 text-xs font-medium">
            <span>What init writes</span>
            <span class="text-accent font-mono">
              {1 + extraFiles.length} files
            </span>
          </figcaption>
          <ul class="divide-border divide-y" role="list">
            <li class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
              <code class="font-mono text-[13px]/6">AGENTS.md</code>
              <span class="flex items-center gap-3">
                <span class="flex items-center">
                  {agentsFileReaders.slice(0, STACK_SIZE).map((reader) => (
                    <img
                      alt=""
                      class="ring-code -mr-1.5 size-6 rounded-md ring-2"
                      height="24"
                      loading="lazy"
                      src={reader.logo}
                      title={reader.name}
                      width="24"
                    />
                  ))}
                </span>
                <span class="text-muted-foreground ml-1.5 text-sm/6">
                  {agentsFileReaders.length} agents
                </span>
              </span>
            </li>
            {extraFiles.map((file) => (
              <li class="bg-signal/7 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-4 py-3 sm:px-6">
                <span class="flex items-center gap-3">
                  <code class="font-mono text-[13px]/6">{file.path}</code>
                  <span class="bg-foreground text-background rounded-sm px-1.5 font-mono text-[11px]/5 tracking-wider uppercase">
                    {file.tag}
                  </span>
                </span>
                <span class="flex items-center gap-3">
                  <img
                    alt=""
                    class="size-6 rounded-md"
                    height="24"
                    loading="lazy"
                    src={file.reader.logo}
                    width="24"
                  />
                  <span class="text-muted-foreground text-sm/6">
                    {file.reader.name}
                  </span>
                </span>
              </li>
            ))}
          </ul>
        </figure>
      </div>
    </div>
  </section>

  <section aria-labelledby="ag-featured" class="border-border border-b">
    <div class="hp-frame border-border mx-auto max-w-7xl border-x">
      <SectionHeading id="ag-featured" title="The frontier agents">
        Claude Code and Codex get the deepest setup: the rules before they
        write, and an <code class="font-mono text-base">ultracite fix</code>{" "}
        flag that hands them whatever autofix can’t settle.
      </SectionHeading>
      <ul
        class="border-border bg-border grid gap-px border-t bg-clip-padding md:grid-cols-2"
        role="list"
      >
        {featured.map((entry) => {
          const details = [
            {
              label: "Rules",
              note: entry.imports
                ? "read on its own, or through an `@AGENTS.md` import in your CLAUDE.md"
                : "read before every task",
              value: "AGENTS.md",
            },
            ...(entry.hook
              ? [
                  {
                    label: "Hook",
                    note: "runs `ultracite fix --hook` after every edit and reports what’s left",
                    value: entry.hook,
                  },
                ]
              : []),
            {
              label: "Fix",
              note: `hands what autofix can’t settle to ${entry.name}`,
              value: `npx ultracite fix ${entry.fixFlag}`,
            },
          ];
          return (
            <li class="bg-background flex flex-col gap-8 px-4 py-8 sm:px-6 lg:px-10 lg:py-10">
              <div class="flex items-center gap-4">
                <img
                  alt=""
                  class="ring-foreground/10 size-14 shrink-0 rounded-xl ring-1"
                  height="56"
                  src={entry.logo}
                  width="56"
                />
                <p class="flex flex-col">
                  <span class="text-3xl font-medium tracking-[-0.03em]">
                    {entry.name}
                  </span>
                  {entry.maker && (
                    <span class="text-muted-foreground text-sm/6">
                      {entry.maker}
                    </span>
                  )}
                </p>
              </div>
              {entry.tagline && (
                <p class="text-muted-foreground max-w-[48ch] text-lg/8 text-pretty">
                  <RichText text={entry.tagline} />
                </p>
              )}
              <dl class="divide-border border-border flex flex-col divide-y border-y">
                {details.map((detail) => (
                  <div class="grid gap-x-6 gap-y-1 py-3.5 sm:grid-cols-[4rem_1fr]">
                    <dt class="text-accent font-mono text-xs/6 tracking-wider uppercase">
                      {detail.label}
                    </dt>
                    <dd class="flex min-w-0 flex-col">
                      <code class="truncate font-mono text-[13px]/6">
                        {detail.value}
                      </code>
                      <span class="text-muted-foreground text-sm/6 text-pretty">
                        <RichText text={detail.note} />
                      </span>
                    </dd>
                  </div>
                ))}
              </dl>
              <p class="mt-auto flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
                {entry.landing && (
                  <a
                    class="group flex items-center gap-2 text-[15px]/6 font-medium"
                    href={`/agents/${entry.id}`}
                  >
                    Ultracite for {entry.name}
                    <Icon
                      class="size-4 transition-transform group-hover:translate-x-0.5"
                      name="arrow-right"
                    />
                  </a>
                )}
                <span class="text-muted-foreground font-mono text-xs/5">
                  --agents {entry.id}
                </span>
              </p>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  {groups.map((group) => (
    <section aria-labelledby={`ag-${group.id}`} class="border-border border-b">
      <div class="hp-frame border-border mx-auto max-w-7xl border-x">
        <SectionHeading id={`ag-${group.id}`} title={group.title}>
          <RichText text={group.description} />
        </SectionHeading>
        <ul
          class="border-border bg-border grid gap-px border-t bg-clip-padding sm:grid-cols-2 lg:grid-cols-3"
          role="list"
        >
          {group.entries.map((entry) => {
            const body = (
              <>
                <span class="flex items-center gap-3">
                  <img
                    alt=""
                    class="ring-foreground/10 size-10 shrink-0 rounded-lg ring-1"
                    height="40"
                    loading="lazy"
                    src={entry.logo}
                    width="40"
                  />
                  <span class="flex min-w-0 flex-col">
                    <span class="text-lg/6 font-medium tracking-[-0.01em]">
                      {entry.name}
                    </span>
                    {entry.maker && (
                      <span class="text-muted-foreground truncate text-sm/5">
                        {entry.maker}
                      </span>
                    )}
                  </span>
                  {entry.landing && (
                    <Icon
                      class="text-muted-foreground group-hover:text-foreground ml-auto size-4 shrink-0 transition-transform group-hover:translate-x-0.5"
                      name="arrow-right"
                    />
                  )}
                </span>
                {entry.tagline && (
                  <span class="text-muted-foreground text-[15px]/6 text-pretty">
                    <RichText text={entry.tagline} />
                  </span>
                )}
                <span class="text-muted-foreground mt-auto flex flex-wrap items-center gap-x-3 gap-y-1 pt-2 font-mono text-xs/5">
                  {entry.extras.map((extra) => (
                    <span class="flex items-center gap-1.5">
                      <span class="text-foreground">{extra.path}</span>
                      <span class="bg-foreground text-background rounded-sm px-1.5 text-[11px]/5 tracking-wider uppercase">
                        {extra.tag}
                      </span>
                    </span>
                  ))}
                  <span class="ml-auto">--agents {entry.id}</span>
                </span>
              </>
            );
            return (
              <li class="bg-background flex">
                {entry.landing ? (
                  <a
                    class="group hover:bg-muted/50 flex w-full flex-col gap-3 px-4 py-6 sm:px-6 lg:px-8"
                    href={`/agents/${entry.id}`}
                  >
                    {body}
                  </a>
                ) : (
                  <div class="flex w-full flex-col gap-3 px-4 py-6 sm:px-6 lg:px-8">
                    {body}
                  </div>
                )}
              </li>
            );
          })}
          {group.entries.length % 3 !== 0 && (
            <li
              aria-hidden="true"
              class="hatch bg-background max-lg:hidden"
              style={{ gridColumn: `span ${3 - (group.entries.length % 3)}` }}
            />
          )}
        </ul>
      </div>
    </section>
  ))}

  <Faq id="ag-faq" items={faqs} title="Agent questions, answered" />
  <Cta />
</LandingLayout>
