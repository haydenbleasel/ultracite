---
// A dark terminal window with a bash icon in its header. The lines go in the
// default slot, in a monospace column.
import Icon from "../home/icon.astro";

interface Props {
  class?: string;
  title?: string;
}

const { class: className, title = "Terminal" } = Astro.props;
---

<div
  class:list={[
    "rounded-blume border-panel-border bg-panel flex min-h-0 min-w-0 flex-col overflow-hidden border",
    className,
  ]}
>
  <p class="border-panel-border text-panel-muted flex h-11 shrink-0 items-center gap-2.5 border-b px-4 text-xs font-medium">
    <Icon class="size-3.5" name="bash" />
    {title}
  </p>
  <div class="text-panel-muted flex min-w-0 flex-col px-5 py-4 font-mono text-[13px]/[1.55]">
    <slot />
  </div>
</div>
