---
import { NEW_TAB_HINT_ID } from "blume/core/new-tab.ts";

import SectionIntro from "./section-intro.astro";

// YouTube facade: ship a thumbnail + play button, swap in the iframe on click.
// Titles and channels are the videos' own, so each creator gets credit.
const videos = [
  {
    author: "Better Stack",
    authorUrl: "https://www.youtube.com/@betterstack",
    id: "lEkXbneUnWg",
    title:
      "The EASIEST Way To Switch From ESLint & Prettier to Biome — Ultracite",
  },
  {
    author: "OrcDev",
    authorUrl: "https://www.youtube.com/@orcdev",
    id: "b_F4LaycQcE",
    title: "This New Tool Made Me Delete ESLint Without Regret",
  },
];
---

<div class="grid gap-8">
  <SectionIntro
    description="Two community walkthroughs of replacing ESLint and Prettier with Ultracite's Biome preset in a real project."
    title="See Ultracite in action"
  />
  <div class="grid w-full gap-8 sm:grid-cols-2">
    {
      videos.map((video) => (
        <figure class="grid gap-3">
          <button
            aria-label={`Play: ${video.title}`}
            class="hp-video group relative isolate block aspect-video w-full overflow-hidden rounded-lg border bg-muted"
            data-video-id={video.id}
            data-video-title={video.title}
            type="button"
          >
            <img
              alt=""
              class="absolute inset-0 size-full object-cover"
              height="360"
              loading="lazy"
              src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
              width="480"
            />
            <span
              class="absolute inset-0 flex items-center justify-center bg-black/20 transition-colors group-hover:bg-black/30"
            >
              <span
                class="flex size-16 items-center justify-center rounded-full bg-black/70 text-white shadow-lg transition-transform group-hover:scale-105"
              >
                <svg
                  aria-hidden="true"
                  class="size-7 translate-x-0.5"
                  fill="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path d="M8 5v14l11-7z"></path>
                </svg>
              </span>
            </span>
          </button>
          <figcaption class="grid gap-0.5 text-sm">
            <span class="font-medium">{video.title}</span>
            <span class="text-muted-foreground">
              by{" "}
              <a
                aria-describedby={NEW_TAB_HINT_ID}
                class="underline"
                href={video.authorUrl}
                rel="noopener noreferrer"
                target="_blank"
              >
                {video.author}
              </a>
            </span>
          </figcaption>
        </figure>
      ))
    }
  </div>
</div>

<script>
  // Swap the whole facade button for a plain wrapper around the player: an
  // iframe inside a <button> is invalid HTML, and a button's children are
  // presentational, which hides the player's controls from screen readers.
  const play = (el: HTMLButtonElement) => {
    const id = el.dataset.videoId;
    if (!id) {
      return;
    }
    const iframe = document.createElement("iframe");
    iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
    iframe.title = el.dataset.videoTitle ?? "YouTube video";
    iframe.allow =
      "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
    iframe.allowFullscreen = true;
    iframe.className = "absolute inset-0 size-full border-0";

    const player = document.createElement("div");
    player.className =
      "relative isolate block aspect-video w-full overflow-hidden rounded-lg border bg-muted";
    player.append(iframe);
    el.replaceWith(player);
    iframe.focus();
  };

  // Runs now and on every `astro:page-load`: the client router executes this
  // module once, so a homepage swapped back in after a navigation would
  // otherwise get play buttons with no listeners. `hpBound` prevents double
  // binding.
  const init = () => {
    for (const el of document.querySelectorAll<HTMLButtonElement>(
      ".hp-video",
    )) {
      if (el.dataset.hpBound) {
        continue;
      }
      el.dataset.hpBound = "true";
      el.addEventListener("click", () => play(el));
    }
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
