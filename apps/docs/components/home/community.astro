---
import { NEW_TAB_HINT_ID } from "blume/core/new-tab.ts";

import { getTweet } from "../../lib/get-tweet";
import SectionHeading from "./section-heading.astro";

// Hand-picked testimonials, fetched at build time. The first is featured
// large; `text` overrides the fetched body (Christopher Burns' is a long note
// the syndication endpoint truncates, quoted here up to its first break).
const entries: { featured?: boolean; id: string; text?: string }[] = [
  {
    featured: true,
    id: "1969727618237820980",
    text: "One of the biggest lessons I learned from my first startup is to set the bar extremely high for code quality and linting from day one. If you do not, it turns into an impossible escalator you can never step off.",
  },
  { id: "1937342910519038142" },
  { id: "1976732830487958011" },
];

// A tweet that fails to load (rate limit, network) is skipped; when none load,
// the quotes are dropped and only the sponsors remain.
const fetched = await Promise.all(entries.map((entry) => getTweet(entry.id)));
const quotes = fetched.flatMap((tweet, index) => {
  const entry = entries[index];
  if (!(tweet && entry)) {
    return [];
  }
  return [
    { ...tweet, featured: entry.featured, text: entry.text ?? tweet.text },
  ];
});

const sponsors = [
  {
    height: 24,
    href: "https://www.coderabbit.ai/",
    name: "CodeRabbit",
    src: "/sponsors/coderabbit.svg",
    width: 128,
  },
  {
    height: 24,
    href: "https://photon.codes/",
    name: "Photon HQ",
    src: "/sponsors/photon-hq.svg",
    width: 113,
  },
  {
    height: 26,
    href: "https://www.tryordinal.com/",
    name: "Ordinal",
    src: "/sponsors/ordinal.svg",
    width: 95,
  },
];
---

<section aria-labelledby="hp-community" class="border-border border-b">
  <div class="mx-auto max-w-7xl border-border border-x">
    {
      quotes.length > 0 && (
        <>
          <SectionHeading id="hp-community" title="Set the bar on day one" />
          <div class="grid gap-px border-border border-t bg-border bg-clip-padding lg:grid-cols-12">
            {quotes.map((quote) => (
              <figure
                class:list={[
                  "m-0 flex flex-col justify-between gap-10 bg-background p-6 sm:p-10",
                  quote.featured ? "lg:col-span-6" : "lg:col-span-3",
                ]}
              >
                <blockquote class="m-0" lang={quote.lang ?? undefined}>
                  <p
                    class:list={[
                      "relative text-pretty font-medium before:absolute before:-translate-x-full before:content-['“'] after:content-['”']",
                      quote.featured
                        ? "max-w-[34ch] text-2xl/9 tracking-[-0.02em] sm:text-[1.75rem]/10"
                        : "text-xl/8 tracking-[-0.015em]",
                    ]}
                  >{quote.text}</p>
                </blockquote>
                <figcaption>
                  <a
                    aria-describedby={NEW_TAB_HINT_ID}
                    class="group flex w-fit items-center gap-3"
                    href={quote.url}
                    rel="noopener noreferrer"
                    target="_blank"
                  >
                    {quote.avatar && (
                      <img
                        alt=""
                        class="size-10 rounded-full outline-1 outline-black/10 -outline-offset-1"
                        height="40"
                        loading="lazy"
                        src={quote.avatar}
                        width="40"
                      />
                    )}
                    <span class="flex flex-col text-sm/5">
                      <span class="font-medium group-hover:underline">
                        {quote.name}
                      </span>
                      <span class="text-muted-foreground">@{quote.handle}</span>
                    </span>
                  </a>
                </figcaption>
              </figure>
            ))}
          </div>
        </>
      )
    }
    <div
      class:list={[
        "flex flex-wrap items-center justify-between gap-x-10 gap-y-6 px-4 py-8 sm:px-6 lg:px-10",
        quotes.length > 0 && "border-border border-t",
      ]}
    >
      <p class="font-medium text-sm/6">Sponsored by</p>
      <ul class="flex flex-wrap items-center gap-x-12 gap-y-6" role="list">
        {
          sponsors.slice(0, 2).map((sponsor) => (
            <li>
              <a
                aria-describedby={NEW_TAB_HINT_ID}
                class="block hover:opacity-70"
                href={sponsor.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                <span
                  aria-label={sponsor.name}
                  class="logo-mask"
                  role="img"
                  style={`--logo-src: url(${sponsor.src}); --logo-width: ${sponsor.width}px; --logo-height: ${sponsor.height}px`}
                />
              </a>
            </li>
          ))
        }
        <li>
          {/* Cloudflare's horizontal lockup, inline so its cloud keeps the
              knockout shape behind it in the page background color. */}
          <a
            aria-describedby={NEW_TAB_HINT_ID}
            aria-label="Cloudflare"
            class="block hover:opacity-70"
            href="https://www.cloudflare.com/"
            rel="noopener noreferrer"
            target="_blank"
          >
            <svg aria-hidden="true" class="h-6 w-auto sm:h-7" viewBox="0 0 181 22"
              ><g transform="translate(-51 0)"
                ><path
                  class="fill-background"
                  d="M94.7,10.6,89.1,9.3l-1-.4-25.7.2V21.5l32.3.1Z"></path><path
                  class="fill-foreground"
                  d="M84.2,20.4a2.85546,2.85546,0,0,0-.3-2.6,3.09428,3.09428,0,0,0-2.1-1.1l-17.4-.2c-.1,0-.2-.1-.3-.1a.1875.1875,0,0,1,0-.3c.1-.2.2-.3.4-.3L82,15.6a6.29223,6.29223,0,0,0,5.1-3.8l1-2.6c0-.1.1-.2,0-.3A11.39646,11.39646,0,0,0,66.2,7.7a5.45941,5.45941,0,0,0-3.6-1A5.20936,5.20936,0,0,0,58,11.3a5.46262,5.46262,0,0,0,.1,1.8A7.30177,7.30177,0,0,0,51,20.4a4.102,4.102,0,0,0,.1,1.1.3193.3193,0,0,0,.3.3H83.5c.2,0,.4-.1.4-.3Z"
                ></path><path
                  class="fill-foreground"
                  d="M89.7,9.2h-.5c-.1,0-.2.1-.3.2l-.7,2.4a2.85546,2.85546,0,0,0,.3,2.6,3.09428,3.09428,0,0,0,2.1,1.1l3.7.2c.1,0,.2.1.3.1a.1875.1875,0,0,1,0,.3c-.1.2-.2.3-.4.3l-3.8.2a6.29223,6.29223,0,0,0-5.1,3.8l-.2.9c-.1.1,0,.3.2.3H98.5a.26517.26517,0,0,0,.3-.3,10.87184,10.87184,0,0,0,.4-2.6,9.56045,9.56045,0,0,0-9.5-9.5"
                ></path></g
              ><path
                class="fill-foreground"
                d="M100.5,27.2a.9.9,0,1,1,.9-.9.89626.89626,0,0,1-.9.9m0-1.6a.7.7,0,1,0,.7.7.68354.68354,0,0,0-.7-.7m.4,1.2h-.2l-.2-.3h-.2v.3h-.2v-.9h.5a.26517.26517,0,0,1,.3.3c0,.1-.1.2-.2.3l.2.3Zm-.3-.5c.1,0,.1,0,.1-.1a.09794.09794,0,0,0-.1-.1h-.3v.3h.3Zm-89.7-.9h2.2v6h3.8v1.9h-6Zm8.3,3.9a4.10491,4.10491,0,0,1,4.3-4.1,4.02,4.02,0,0,1,4.2,4.1,4.10491,4.10491,0,0,1-4.3,4.1,4.07888,4.07888,0,0,1-4.2-4.1m6.3,0a2.05565,2.05565,0,0,0-2-2.2,2.1025,2.1025,0,0,0,0,4.2c1.2.2,2-.8,2-2m4.9.5V25.4h2.2v4.4c0,1.1.6,1.7,1.5,1.7a1.39926,1.39926,0,0,0,1.5-1.6V25.4h2.2v4.4c0,2.6-1.5,3.7-3.7,3.7-2.3-.1-3.7-1.2-3.7-3.7m10.7-4.4h3.1c2.8,0,4.5,1.6,4.5,3.9s-1.7,4-4.5,4h-3V25.4Zm3.1,5.9a2.00909,2.00909,0,1,0,0-4h-.9v4Zm7.6-5.9h6.3v1.9H54v1.3h3.7v1.8H54v2.9H51.8Zm9.4,0h2.2v6h3.8v1.9h-6Zm11.7-.1h2.2l3.4,8H76.1l-.6-1.4H72.4l-.6,1.4H69.5Zm2,4.9L74,28l-.9,2.2Zm6.4-4.8H85a3.41818,3.41818,0,0,1,2.6.9,2.62373,2.62373,0,0,1-.9,4.2l1.9,2.8H86.1l-1.6-2.4h-1v2.4H81.3Zm3.6,3.8c.7,0,1.2-.4,1.2-.9,0-.6-.5-.9-1.2-.9H83.5v1.9h1.4Zm6.5-3.8h6.4v1.8H93.6v1.2h3.8v1.8H93.6v1.2h4.3v1.9H91.4ZM6.1,30.3a1.97548,1.97548,0,0,1-1.8,1.2,2.1025,2.1025,0,0,1,0-4.2,2.0977,2.0977,0,0,1,1.9,1.3H8.5a4.13459,4.13459,0,0,0-4.2-3.3A4.1651,4.1651,0,0,0,0,29.4a4.07888,4.07888,0,0,0,4.2,4.1,4.31812,4.31812,0,0,0,4.2-3.2Z"
                transform="translate(54 7.9) scale(1.25) translate(0 -25.2)"
              ></path></svg
            >
          </a>
        </li>
        {
          sponsors.slice(2).map((sponsor) => (
            <li>
              <a
                aria-describedby={NEW_TAB_HINT_ID}
                class="block hover:opacity-70"
                href={sponsor.href}
                rel="noopener noreferrer"
                target="_blank"
              >
                <span
                  aria-label={sponsor.name}
                  class="logo-mask"
                  role="img"
                  style={`--logo-src: url(${sponsor.src}); --logo-width: ${sponsor.width}px; --logo-height: ${sponsor.height}px`}
                />
              </a>
            </li>
          ))
        }
      </ul>
      <a
        aria-describedby={NEW_TAB_HINT_ID}
        class="text-muted-foreground text-sm/6 hover:text-foreground"
        href="https://github.com/sponsors/haydenbleasel"
        rel="noopener noreferrer"
        target="_blank"
      >
        Become a sponsor →
      </a>
    </div>
  </div>
</section>
