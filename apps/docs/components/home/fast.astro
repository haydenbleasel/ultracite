---
import { runFor } from "../../lib/benchmarks";
import SectionHeading from "./section-heading.astro";

// Medians on an Apple M1 Pro, end to end through the ultracite CLI. The single
// file is the component from the hero's session; the project is the repo's
// benchmark fixture at 42 files (lib/benchmarks).
const project = runFor(42);

const stats = [
  { label: "Check the file your agent just edited", ms: 330 },
  { label: "Check a whole 42-file project", ms: Math.round(project.ms.oxlint) },
  { label: "The same project on Biome", ms: Math.round(project.ms.biome) },
];
---

<section aria-labelledby="hp-fast" class="border-border border-b">
  <div class="hp-frame border-border mx-auto max-w-7xl border-x">
    <SectionHeading id="hp-fast" title="Fast enough to run after every edit">
      Agents check their work after nearly every change. Ultracite answers in
      about a third of a second, so the check never becomes the slow part of the
      loop.
    </SectionHeading>
    <figure class="border-border m-0 border-t">
      <div class="flex flex-col gap-4 px-4 pt-10 pb-8 sm:px-6 lg:px-10 lg:pt-14">
        <p class="text-muted-foreground font-mono text-xs/5 tracking-wider uppercase">
          One agent turn
        </p>
        <div class="flex h-20 items-stretch gap-1 sm:h-24">
          <div class="hatch bg-muted/70 ring-foreground/10 relative flex min-w-0 flex-1 items-center py-2 pr-16 pl-4 ring-1 ring-inset sm:pr-28 sm:pl-6">
            <p class="min-w-0 text-[15px]/6 text-pretty sm:text-base/7">
              <span class="font-medium">
                Your agent reads, thinks and writes the edit
              </span>
              <span class="text-muted-foreground max-sm:hidden">
                {" "}
                · seconds to minutes, depending on the model and task
              </span>
            </p>
            <span
              aria-hidden="true"
              class="border-foreground/25 bg-background absolute inset-y-0 right-10 w-3 -skew-x-12 border-x sm:right-16"
            ></span>
          </div>
          <div class="bg-signal w-2.5 shrink-0 sm:w-3"></div>
        </div>
        <div class="flex items-start justify-end gap-3">
          <p class="text-right text-[15px]/6">
            <span class="font-medium">ultracite check</span>{" "}
            <span class="text-muted-foreground">· 330 ms</span>
          </p>
          <span
            aria-hidden="true"
            class="bg-foreground mr-[3px] h-6 w-px -translate-y-4 sm:mr-[5px]"
          ></span>
        </div>
      </div>
      <dl class="border-border bg-border grid gap-px border-t bg-clip-padding sm:grid-cols-3">
        {stats.map((stat) => (
          <div class="bg-background flex flex-col gap-3 px-4 py-8 sm:px-6 lg:px-10">
            <dt class="text-muted-foreground text-[15px]/6 text-pretty">
              {stat.label}
            </dt>
            <dd class="order-first text-5xl font-medium tracking-[-0.04em] tabular-nums">
              {stat.ms}
              <span class="text-muted-foreground ml-1 text-2xl tracking-normal">
                ms
              </span>
            </dd>
          </div>
        ))}
      </dl>
      <figcaption class="border-border text-muted-foreground border-t px-4 py-5 text-sm/6 text-pretty sm:px-6 lg:px-10">
        Agent time isn’t drawn to scale. Check times are medians on an Apple M1
        Pro, end to end through the{" "}
        <code class="font-mono text-[13px]">ultracite</code> CLI on Oxlint
        unless noted: the single file is the component in the session above, and
        the project is the repo’s benchmark fixture (
        <code class="font-mono text-[13px]">bun ./benchmark/index.ts</code>).
      </figcaption>
    </figure>
  </div>
</section>
