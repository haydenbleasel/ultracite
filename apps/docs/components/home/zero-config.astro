---
import CodeBlock from "blume/components/content/CodeBlock.astro";
import Tab from "blume/components/content/Tab.astro";
import Tabs from "blume/components/content/Tabs.astro";
import { providerLogos, prettierLogo, stylelintLogo } from "../../lib/logos";
import { providers } from "../../lib/providers";
import SectionIntro from "./section-intro.astro";

// A representative, fixed preset set: what `ultracite init` writes after picking
// React, Next.js and Vitest / Bun (in the prompt's order) — the same answers the
// hero's terminal mock shows. Highlighted at build time, so the page ships no
// client-side highlighter.
const PRESETS = ["core", "react", "next", "vitest"];

const langFor = (lang: string): string => {
  if (lang === "json") {
    return "json";
  }
  if (lang === "typescript") {
    return "typescript";
  }
  return "javascript";
};

// oxlint first, to match the previous default selection.
const rank = (id: string): number => (id === "oxlint" ? 0 : 1);
const ordered = providers.toSorted((a, b) => rank(a.id) - rank(b.id));
const defaultProvider = ordered[0]?.id;

const logos = [
  ...providers.map((provider) => ({
    name: provider.name.split(" ")[0],
    src: providerLogos[provider.id],
  })),
  { name: "Prettier", src: prettierLogo },
  { name: "Stylelint", src: stylelintLogo },
];
---

<div class="grid gap-8">
  <ul class="flex items-center justify-center -space-x-1">
    {
      logos.map((logo) => (
        <li class="hp-tt inline-flex">
          <img
            alt={logo.name}
            class="size-7 overflow-hidden rounded-full object-cover ring-2 ring-background md:size-10 lg:size-12"
            height="48"
            src={logo.src}
            width="48"
          />
          <span aria-hidden="true" data-tt>
            {logo.name}
          </span>
        </li>
      ))
    }
  </ul>
  <SectionIntro
    description="Hundreds of rules for your framework to optimize your JavaScript / TypeScript code, while still allowing you to customize when needed."
    maxWidth="max-w-xl"
    title="Works with your favorite tools"
  />

  <div class="flex flex-col items-center justify-center gap-3">
    <span class="text-muted-foreground text-sm" id="hp-provider-label">
      I'm using
    </span>
    <div
      aria-labelledby="hp-provider-label"
      class="flex flex-wrap items-center justify-center gap-2"
      role="group"
    >
      {
        ordered.map((provider) => (
          <button
            aria-pressed={String(provider.id === defaultProvider)}
            class="hp-provider flex items-center gap-2 rounded-full border px-3 py-1.5 text-sm transition-colors"
            data-provider={provider.id}
            type="button"
          >
            {providerLogos[provider.id] && (
              <img
                alt=""
                class="size-4 rounded-full"
                height="16"
                src={providerLogos[provider.id]}
                width="16"
              />
            )}
            <span>{provider.name}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="mx-auto w-full max-w-3xl">
    {
      ordered.map((provider) => (
        <div
          data-hp-panel={provider.id}
          hidden={provider.id !== defaultProvider}
        >
          <Tabs hash={false} sync={false}>
            {provider.configFiles.map((file) => (
              <Tab class="hp-code p-0!" title={file.name}>
                <CodeBlock
                  code={file.code(PRESETS)}
                  icons={false}
                  lang={langFor(file.lang)}
                />
              </Tab>
            ))}
          </Tabs>
        </div>
      ))
    }
    <p class="mt-3 text-center text-muted-foreground text-xs">
      What <code>ultracite init</code> writes with the React, Next.js and
      Vitest presets.
    </p>
  </div>
</div>

<script>
  const showProvider = (id: string) => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      ".hp-provider",
    )) {
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.provider === id),
      );
    }
    for (const panel of document.querySelectorAll<HTMLElement>(
      "[data-hp-panel]",
    )) {
      panel.hidden = panel.dataset.hpPanel !== id;
    }
  };

  // Runs now and on every `astro:page-load`: the client router executes this
  // module once, so a homepage swapped back in after a navigation would
  // otherwise get buttons with no listeners. `hpBound` prevents double binding.
  const init = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>(
      ".hp-provider",
    )) {
      if (button.dataset.hpBound) {
        continue;
      }
      button.dataset.hpBound = "true";
      button.addEventListener("click", () =>
        showProvider(button.dataset.provider ?? ""),
      );
    }
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
