---
import Icon from "./icon.astro";

interface Props {
  human?: string;
  agent?: string;
  class?: string;
}

const {
  human = "npx ultracite@latest init",
  agent = "npx skills add haydenbleasel/ultracite",
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "hp-installer flex h-10 w-full items-center gap-1 rounded-full border bg-background px-1 font-mono text-sm",
    className,
  ]}
  data-human={human}
  data-agent={agent}
>
  <div class="flex items-center gap-1 pl-px">
    <div class="flex gap-0.5 rounded-full bg-muted p-0.5">
      <button
        aria-label="Human command"
        aria-pressed="true"
        class="hp-mode flex size-6 items-center justify-center rounded-full transition-colors"
        data-mode="human"
        title="Human"
        type="button"
      >
        <Icon class="size-3.5" name="user" />
      </button>
      <button
        aria-label="Agent command"
        aria-pressed="false"
        class="hp-mode flex size-6 items-center justify-center rounded-full transition-colors"
        data-mode="agent"
        title="Agent"
        type="button"
      >
        <Icon class="size-3.5" name="bot" />
      </button>
    </div>
    <span class="px-1 text-muted-foreground">$</span>
  </div>

  {/*
    No outline-none here: Blume's base :focus-visible ring is the only focus
    indicator this read-only field has.
  */}
  <input
    aria-label="Install command"
    class="hp-cmd min-w-0 flex-1 rounded-sm bg-transparent text-foreground"
    readonly
    value={human}
  />

  <button
    aria-label="Copy command"
    class="hp-copy mr-1 flex size-7 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground"
    title="Copy command"
    type="button"
  >
    <Icon class="hp-copy-icon size-3.5" name="copy" />
    <Icon class="hp-check-icon hidden size-3.5" name="check" />
  </button>
  <span aria-live="polite" class="hp-copy-status sr-only"></span>
</div>

<script>
  const ACTIVE = ["bg-background", "text-foreground", "shadow-sm"];

  // Blume's layouts use Astro's client router, which runs this module once per
  // session and never again after a navigation swaps the homepage back in. So
  // setup runs now (interactive before `load`) and again on every
  // `astro:page-load`; the `hpBound` flag keeps it from binding twice.
  const setupInstaller = (el: HTMLElement) => {
    if (el.dataset.hpBound) {
      return;
    }
    const input = el.querySelector<HTMLInputElement>(".hp-cmd");
    const modes = el.querySelectorAll<HTMLButtonElement>(".hp-mode");
    const copyBtn = el.querySelector<HTMLButtonElement>(".hp-copy");
    const copyIcon = el.querySelector<SVGElement>(".hp-copy-icon");
    const checkIcon = el.querySelector<SVGElement>(".hp-check-icon");
    const status = el.querySelector<HTMLElement>(".hp-copy-status");
    if (!(input && copyBtn && copyIcon && checkIcon && status)) {
      return;
    }
    el.dataset.hpBound = "true";

    const commands = {
      agent: el.dataset.agent ?? "",
      human: el.dataset.human ?? "",
    };
    let mode: keyof typeof commands = "human";

    const setMode = (next: keyof typeof commands) => {
      mode = next;
      input.value = commands[next];
      for (const button of modes) {
        const active = button.dataset.mode === next;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("text-muted-foreground", !active);
        for (const cls of ACTIVE) {
          button.classList.toggle(cls, active);
        }
      }
    };

    for (const button of modes) {
      button.addEventListener("click", () =>
        setMode(button.dataset.mode === "agent" ? "agent" : "human")
      );
    }

    let timer: ReturnType<typeof setTimeout>;
    copyBtn.addEventListener("click", async () => {
      clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(commands[mode]);
      } catch {
        // Clipboard access can be blocked (permissions, insecure context).
        // Select the command so it can be copied by hand instead of flashing
        // a success check for a copy that never happened.
        input.select();
        status.textContent = "Copy failed. The command is selected.";
        return;
      }
      copyIcon.classList.add("hidden");
      checkIcon.classList.remove("hidden");
      status.textContent = "Copied to clipboard";
      timer = setTimeout(() => {
        copyIcon.classList.remove("hidden");
        checkIcon.classList.add("hidden");
        status.textContent = "";
      }, 2000);
    });

    setMode("human");
  };

  const init = () => {
    for (const el of document.querySelectorAll<HTMLElement>(".hp-installer")) {
      setupInstaller(el);
    }
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
