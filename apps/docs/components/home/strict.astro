---
import SectionHeading from "./section-heading.astro";

// The component an agent wrote in the hero's session, with the diagnostics
// Ultracite's Oxlint core + React presets report for it. Each line is a list of
// [text, kind] tokens; `squiggle` marks the span a diagnostic points at.
type Token = [string, ("keyword" | "string" | "type" | "tag" | "squiggle")?];

interface Line {
  code: Token[];
  problems?: string;
}

const lines: Line[] = [
  {
    code: [
      ["import", "keyword"],
      [" { useEffect, useState } "],
      ["from", "keyword"],
      [" "],
      ['"react"', "string"],
      [";"],
    ],
  },
  { code: [] },
  {
    code: [
      ["export", "keyword"],
      [" "],
      ["function UserList", "squiggle"],
      ["({ teamId }: { teamId: "],
      ["string", "type"],
      [" }) {"],
    ],
    problems: "func-style · function-component-definition",
  },
  {
    code: [
      ["  "],
      ["const", "keyword"],
      [" [users, setUsers] = useState<"],
      ["any", "squiggle"],
      ["[]>([]);"],
    ],
    problems: "no-explicit-any",
  },
  { code: [] },
  { code: [["  useEffect(() => {"]] },
  {
    code: [
      ["    "],
      ["fetch", "squiggle"],
      ["("],
      ["`/api/teams/${", "string"],
      ["teamId", "squiggle"],
      ["}/users`", "string"],
      [")"],
    ],
    problems: "catch-or-return · exhaustive-deps",
  },
  { code: [["      .then((res) => res.json())"]] },
  { code: [["      .then((data) => setUsers(data));"]] },
  {
    code: [["  }, "], ["[]", "squiggle"], [");"]],
    problems: "exhaustive-effect-dependencies",
  },
  { code: [] },
  { code: [["  "], ["return", "keyword"], [" ("]] },
  { code: [["    <"], ["ul", "tag"], [">"]] },
  { code: [["      {users.map((user) => ("]] },
  {
    code: [
      ["        <"],
      ["li", "tag"],
      [" "],
      ["key", "type"],
      ["={user.id}>"],
    ],
  },
  {
    code: [
      ["          <"],
      ["img", "squiggle"],
      [" "],
      ["src", "type"],
      ["={user.avatar} />"],
    ],
    problems: "jsx-a11y/alt-text",
  },
  {
    code: [
      ["          {"],
      [
        'user.role == "admin" ? "Admin" : user.role == "owner" ? "Owner" : "Member"',
        "squiggle",
      ],
      ["}"],
    ],
    problems: "no-nested-ternary · eqeqeq ×2",
  },
  { code: [["        </"], ["li", "tag"], [">"]] },
  { code: [["      ))}"]] },
  { code: [["    </"], ["ul", "tag"], [">"]] },
  { code: [["  );"]] },
  { code: [["}"]] },
];

const tokenClass = {
  keyword: "text-syntax-keyword",
  squiggle: "squiggle",
  string: "text-syntax-string",
  tag: "text-syntax-tag",
  type: "text-syntax-type",
};

const problemCount = 10;

const families = [
  {
    name: "Type safety",
    rules: ["no-explicit-any", "no-non-null-assertion", "no-floating-promises"],
  },
  {
    name: "React and hooks",
    rules: ["exhaustive-deps", "jsx-key", "button-has-type"],
  },
  {
    name: "Accessibility",
    rules: ["alt-text", "anchor-is-valid", "aria-role"],
  },
  {
    name: "Async and correctness",
    rules: ["eqeqeq", "require-await", "no-await-in-loop"],
  },
];
---

<section aria-labelledby="hp-strict" class="border-border border-b">
  <div class="hp-frame border-border mx-auto max-w-7xl border-x">
    <SectionHeading
      id="hp-strict"
      title="Strict enough to catch what agents get wrong"
    >
      Models write confident code with loose types, stale effect dependencies
      and missing alt text. Ultracite turns on hundreds of rules across type
      safety, React, accessibility and async code, so those patterns fail the
      check instead of reaching your review queue.
    </SectionHeading>
    <div class="border-border bg-muted/60 border-t p-2 sm:p-6 lg:p-10">
      <div class="bg-code ring-foreground/10 overflow-hidden rounded-lg ring-1">
        <div class="border-border text-muted-foreground flex h-10 items-center justify-between gap-4 border-b px-4 font-mono text-xs/5">
          <span class="flex items-center gap-2">
            <span
              aria-hidden="true"
              class="bg-signal size-1.5 rounded-full"
            ></span>
            src/components/user-list.tsx
          </span>
          <span class="text-accent">{problemCount} problems</span>
        </div>
        <div class="overflow-x-auto py-4">
          <div class="text-foreground w-max min-w-full font-mono text-[13px]/[1.85]">
            {lines.map((line, index) => (
              <div
                class:list={[
                  "flex pr-6",
                  line.problems && "bg-signal/7 items-baseline",
                ]}
              >
                <span
                  class:list={[
                    "w-13 shrink-0 pr-4 text-right select-none",
                    line.problems ? "text-accent" : "text-muted-foreground/60",
                  ]}
                >
                  {index + 1}
                </span>
                <code class="whitespace-pre">
                  {line.code.map(([text, kind]) =>
                    kind ? <span class={tokenClass[kind]}>{text}</span> : text
                  )}
                </code>
                {line.problems && (
                  <span class="text-accent ml-auto shrink-0 pl-10 text-xs">
                    {line.problems}
                  </span>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
    <dl class="border-border bg-border grid grid-cols-2 gap-px border-t bg-clip-padding lg:grid-cols-5">
      {families.map((family) => (
        <div class="bg-background flex flex-col gap-1.5 px-4 py-6 sm:px-6 lg:px-8">
          <dt class="text-base/7 font-medium">{family.name}</dt>
          <dd class="text-muted-foreground flex flex-col font-mono text-[12.5px]/6">
            {family.rules.map((rule) => (
              <span class="truncate">{rule}</span>
            ))}
          </dd>
        </div>
      ))}
      <div class="hatch bg-background col-span-2 flex flex-col gap-1.5 px-4 py-6 sm:px-6 lg:col-span-1 lg:px-8">
        <dt class="flex items-center gap-2 text-base/7 font-medium">
          Anti-slop
          <span class="border-foreground/20 text-muted-foreground rounded-sm border px-1.5 font-mono text-[11px]/5 tracking-wider uppercase">
            Opt-in
          </span>
        </dt>
        <dd class="text-muted-foreground text-[15px]/6 text-pretty">
          <a
            class="hover:text-foreground underline underline-offset-2"
            href="/docs/presets#anti-slop-rules"
          >
            Dillon Mulroy’s rules
          </a>{" "}
          against unjustified type assertions,{" "}
          <code class="font-mono text-[13px]">unknown</code> leaking through
          signatures and other escape hatches.
        </dd>
      </div>
    </dl>
  </div>
</section>
