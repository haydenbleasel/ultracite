---
import { NEW_TAB_HINT_ID } from "blume/core/new-tab.ts";

// Each logo is drawn in the text color from its SVG (a CSS mask), at a size
// that gives every mark about the same visual weight: wide wordmarks get
// shorter, compact ones taller (width × height ≈ 2,600px²).
const logos = [
  { height: 27, name: "OpenAI", src: "/customers/openai.svg", width: 98 },
  { height: 23, name: "Vercel", src: "/customers/vercel.svg", width: 114 },
  { height: 21, name: "Profound", src: "/customers/profound.svg", width: 124 },
  { height: 26, name: "Adobe", src: "/customers/adobe.svg", width: 99 },
  { height: 27, name: "Clerk", src: "/customers/clerk.svg", width: 95 },
  {
    height: 33,
    name: "Alan Turing Institute",
    src: "/customers/ati.svg",
    width: 79,
  },
  { height: 28, name: "Prisma", src: "/customers/prisma.svg", width: 91 },
  {
    height: 39,
    name: "French Government",
    src: "/customers/french-government.svg",
    width: 66,
  },
  { height: 19, name: "Tencent", src: "/customers/tencent.svg", width: 139 },
  { height: 21, name: "PostHog", src: "/customers/posthog.svg", width: 122 },
  { height: 22, name: "Axiom", src: "/customers/axiom.svg", width: 120 },
  { height: 23, name: "Resend", src: "/customers/resend.svg", width: 111 },
  { height: 27, name: "Neon", src: "/customers/neon.svg", width: 96 },
  {
    height: 18,
    name: "ElevenLabs",
    src: "/customers/elevenlabs.svg",
    width: 142,
  },
  { height: 24, name: "Mintlify", src: "/customers/mintlify.svg", width: 109 },
  { height: 24, name: "Sentry", src: "/customers/sentry.svg", width: 108 },
  { height: 26, name: "Raycast", src: "/customers/raycast.svg", width: 100 },
  { height: 21, name: "Moonshot", src: "/customers/moonshot.svg", width: 126 },
];
---

<section aria-labelledby="hp-trusted" class="border-border border-b">
  <div class="hp-frame mx-auto max-w-7xl border-border border-x">
    <div
      class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-border border-b px-4 py-5 sm:px-6 lg:px-10"
    >
      <h2 class="font-medium font-sans text-sm/6 tracking-normal" id="hp-trusted">
        Used by engineering teams at
      </h2>
      <a
        aria-describedby={NEW_TAB_HINT_ID}
        class="text-muted-foreground text-sm/6 hover:text-foreground"
        href="https://github.com/haydenbleasel/ultracite/network/dependents"
        rel="noreferrer"
        target="_blank"
      >
        …and thousands of open source projects →
      </a>
    </div>
    <ul class="grid grid-cols-2 gap-px bg-border sm:grid-cols-3 lg:grid-cols-6" role="list">
      {
        logos.map((logo) => (
          <li class="flex h-20 items-center justify-center bg-background px-5 sm:h-28 sm:px-6">
            <span
              aria-label={logo.name}
              class="logo-mask"
              role="img"
              style={`--logo-src: url(${logo.src}); --logo-width: ${logo.width}px; --logo-height: ${logo.height}px`}
            />
          </li>
        ))
      }
    </ul>
  </div>
</section>
