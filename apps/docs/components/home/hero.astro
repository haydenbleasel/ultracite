---
import Icon from "./icon.astro";
import Installer from "./installer.astro";

interface Props {
  description: string;
  version: string;
}

const { description, version } = Astro.props;
---

<div class="grid gap-8 sm:gap-20">
  <div class="grid justify-items-center gap-4 text-center">
    <a
      class="group flex w-fit items-center gap-2 text-muted-foreground text-sm transition-colors hover:text-foreground"
      href="/changelog"
    >
      <span
        aria-hidden="true"
        class="size-2 shrink-0 rounded-full bg-emerald-500"></span>
      <span>Latest update — v{version} released</span>
      <Icon
        class="size-4 transition-transform group-hover:translate-x-0.5"
        name="arrow-right"
      />
    </a>

    <h1
      class="mb-0 max-w-2xl text-balance font-medium text-4xl leading-none tracking-tight md:text-5xl lg:text-6xl"
    >
      The linter and formatter for agentic development
    </h1>

    <p
      class="max-w-xl text-balance text-muted-foreground tracking-tight sm:text-lg md:text-xl leading-normal"
    >
      {description}
    </p>

    <div
      class="mt-4 flex w-full max-w-md flex-col items-center gap-2 sm:flex-row"
    >
      <Installer />
    </div>
  </div>

  <slot />
</div>
