---
import Installer from "./installer.astro";
import Logo from "./logo.astro";

interface Props {
  /** The install command, for a landing page that preselects an engine. */
  command?: string;
}

const { command } = Astro.props;
---

<section aria-labelledby="hp-cta">
  <div class="hp-frame border-border bg-signal text-ink relative mx-auto max-w-7xl overflow-hidden border-x">
    <Logo class="text-ink/90 pointer-events-none absolute -right-24 -bottom-40 size-[34rem] max-lg:hidden" />
    <div class="relative flex flex-col gap-8 px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <h2
        class="max-w-[14ch] text-5xl font-medium tracking-[-0.045em] text-balance sm:text-6xl lg:text-7xl"
        id="hp-cta"
      >
        Ship less slop
      </h2>
      <p class="text-ink/80 max-w-[44ch] text-lg/8 text-pretty">
        One command sets up your linter, formatter, editor and agents. Works
        with Oxlint, Biome and ESLint.
      </p>
      <Installer command={command} tone="inverse" wide={Boolean(command)} />
    </div>
  </div>
</section>
