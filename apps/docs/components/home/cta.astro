---
import Installer from "./installer.astro";
import Logo from "./logo.astro";

interface Props {
  /** The install command, for a landing page that preselects an engine. */
  command?: string;
}

const { command } = Astro.props;
---

<section aria-labelledby="hp-cta">
  <div
    class="hp-frame relative mx-auto max-w-7xl overflow-hidden border-border border-x bg-signal text-ink"
  >
    <Logo
      class="pointer-events-none absolute -right-24 -bottom-40 size-[34rem] text-ink/90 max-lg:hidden"
    />
    <div class="relative flex flex-col gap-8 px-4 py-20 sm:px-6 lg:px-10 lg:py-28">
      <h2
        class="max-w-[14ch] text-balance font-medium text-5xl tracking-[-0.045em] sm:text-6xl lg:text-7xl"
        id="hp-cta"
      >
        Ship less slop
      </h2>
      <p class="max-w-[44ch] text-pretty text-ink/80 text-lg/8">
        One command sets up your linter, formatter, editor and agents. Works
        with Oxlint, Biome and ESLint.
      </p>
      <Installer command={command} tone="inverse" wide={Boolean(command)} />
    </div>
  </div>
</section>
