---
// The lint rules a post is about, by their config names. A long name (most
// jsx-a11y rules) would wrap mid-word in a narrow column, so each tag stays on
// one line and truncates at the column's width.
interface Props {
  class?: string;
  rules: string[];
}

const { class: className, rules } = Astro.props;
---

{
  rules.length > 0 && (
    <ul
      class:list={["flex flex-wrap content-start items-start gap-1.5", className]}
      role="list"
    >
      {rules.map((rule) => (
        <li class="min-w-0 max-w-full truncate rounded-sm bg-muted px-1.5 py-0.5 font-mono text-muted-foreground text-xs/5">
          {rule}
        </li>
      ))}
    </ul>
  )
}
