---
// A blog post: the header on the homepage hero's grid, then the post's body
// (the default slot) in a prose column, with its sections and rules in a rail
// beside it. pages/blog/<slug>.astro renders this around the post's MDX.
import data from "blume:data";

import "../../styles/blog.css";

import { isoDate, postFor } from "../../lib/blog";
import type { Heading, JsonLdNode } from "../../lib/blog";
import Icon from "../home/icon.astro";
import BlogLayout from "./blog-layout.astro";
import RuleTags from "./rule-tags.astro";

interface Props {
  /** The MDX module's `file` export. */
  file: string;
  /** The MDX module's `getHeadings()`. */
  headings: Heading[];
}

const { file, headings } = Astro.props;
const post = postFor(file);

if (Astro.url.pathname !== post.href) {
  throw new Error(
    `${Astro.url.pathname} renders blog/${post.slug}.mdx. Rename the page to pages/research/${post.slug}.astro so the URL matches the post.`
  );
}

const sections = headings.filter((heading) => heading.depth === 2);

const siteUrl = data.config.site ?? "https://www.ultracite.ai";
const url = new URL(post.href, siteUrl).href;
const indexUrl = new URL("/research", siteUrl).href;

// The post's share card, rendered from its title and description by
// pages/research/_og-card.png.ts.
const ogImage = `/research/og/${post.slug}.png`;

const article: JsonLdNode = {
  "@id": `${url}#article`,
  "@type": "BlogPosting",
  author: { "@type": "Person", name: post.author.name, url: post.author.url },
  dateModified: isoDate(post.updated ?? post.date),
  datePublished: isoDate(post.date),
  description: post.description,
  headline: post.title,
  image: new URL(ogImage, siteUrl).href,
  inLanguage: "en",
  isPartOf: { "@id": `${indexUrl}#research` },
  mainEntityOfPage: url,
  publisher: {
    "@type": "Organization",
    logo: new URL("/logo.svg", siteUrl).href,
    name: "Ultracite",
    url: siteUrl,
  },
  url,
};

if (post.rules.length > 0) {
  article.keywords = post.rules.join(", ");
}

const jsonLd: JsonLdNode = {
  "@context": "https://schema.org",
  "@graph": [
    article,
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { item: siteUrl, name: "Home" },
        { item: indexUrl, name: "Research" },
        { item: url, name: post.title },
      ].map((crumb, index) => ({
        "@type": "ListItem",
        ...crumb,
        position: index + 1,
      })),
    },
  ],
};
---

<BlogLayout
  description={post.description}
  jsonLd={jsonLd}
  ogImage={ogImage}
  ogImageAlt={`${post.title}: ${post.description}`}
  title={`${post.title} — Ultracite Research`}
>
  <article aria-labelledby="post-title">
    <header class="border-border border-y">
      <div class="hp-frame border-border mx-auto max-w-7xl border-x">
        <div class="px-4 pt-10 pb-12 sm:px-6 sm:pt-14 lg:px-10 lg:pt-16 lg:pb-14">
          <a
            class="group text-muted-foreground hover:text-foreground inline-flex items-center gap-2 font-mono text-xs/5"
            href="/research"
          >
            <Icon
              class="size-3.5 rotate-180 transition-transform group-hover:-translate-x-0.5"
              name="arrow-right"
            />
            Research
          </a>
          <h1
            class="mt-10 max-w-[22ch] text-4xl font-medium tracking-[-0.045em] text-balance sm:text-5xl lg:mt-12 lg:text-6xl"
            id="post-title"
          >
            {post.title}
          </h1>
          <p class="text-muted-foreground mt-8 max-w-[56ch] text-lg/8 text-pretty">
            {post.description}
          </p>
          <p class="text-muted-foreground mt-10 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs/5">
            <a class="text-foreground hover:underline" href={post.author.url}>
              {post.author.name}
            </a>
            <span aria-hidden="true">·</span>
            <span>{post.readingMinutes} min read</span>
          </p>
        </div>
      </div>
    </header>

    <div class="border-border border-b">
      <div class="hp-frame border-border mx-auto grid max-w-7xl border-x lg:grid-cols-12">
        <div class="min-w-0 px-4 py-12 sm:px-6 sm:py-16 lg:col-span-8 lg:px-10 lg:py-20">
          <div class="blog-prose prose max-w-[64ch]">
            <slot />
          </div>
        </div>
        <aside
          aria-label="About this post"
          class="border-border border-t px-4 py-10 sm:px-6 lg:col-span-4 lg:border-t-0 lg:border-l lg:px-10 lg:py-20"
        >
          <div class="flex flex-col gap-10 lg:sticky lg:top-24">
            {sections.length > 0 && (
              <nav aria-labelledby="post-sections" class="max-lg:hidden">
                <p
                  class="text-muted-foreground font-mono text-xs/5"
                  id="post-sections"
                >
                  In this post
                </p>
                <ol class="mt-4 flex flex-col gap-2.5" role="list">
                  {sections.map((section) => (
                    <li>
                      <a
                        class="text-muted-foreground hover:text-foreground text-sm/6 text-pretty"
                        href={`#${section.slug}`}
                      >
                        {section.text}
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
            {post.rules.length > 0 && (
              <div>
                <p class="text-muted-foreground font-mono text-xs/5">
                  Rules in this post
                </p>
                <RuleTags class="mt-4" rules={post.rules} />
              </div>
            )}
            <a
              class="group inline-flex items-center gap-2 text-[15px]/6 font-medium"
              href="/research"
            >
              All research
              <Icon
                class="size-4 transition-transform group-hover:translate-x-0.5"
                name="arrow-right"
              />
            </a>
          </div>
        </aside>
      </div>
    </div>
  </article>
</BlogLayout>
