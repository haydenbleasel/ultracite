---
import Icon from "../../home/icon.astro";
import RichText from "../../landing/rich-text.astro";

// A real `opencode run` transcript (OpenCode 1.18.35, Oxlint 1.87.0) with the
// plugin from plugin.astro installed. The model was a local stand-in scripted
// to make the two edits; the lines below are as OpenCode and Ultracite printed
// them, with the edit's diff trimmed to its hunk.
const steps = [
  {
    body: "It writes `var` and `any`, without semicolons.",
    title: "The agent writes a file",
  },
  {
    body: "`ultracite fix` turns `var` into `const`, formats the file, and adds the one problem it can’t fix to the tool result.",
    title: "The plugin fixes what it can",
  },
  {
    body: "The model reads that result before its next step, and the file passes `ultracite check`.",
    title: "The agent fixes the rest",
  },
];
---

<div class="grid gap-2 sm:gap-4 lg:grid-cols-12">
  <figure class="rounded-blume border-panel-border bg-panel text-panel-foreground m-0 min-w-0 overflow-hidden border lg:col-span-8">
    <div class="border-panel-border text-panel-muted flex h-11 items-center justify-between gap-4 border-b px-4 text-xs font-medium">
      <span class="flex items-center gap-2.5">
        <Icon class="size-3.5" name="bash" />
        opencode run
      </span>
      <span>OpenCode 1.18.35</span>
    </div>
    <div class="overflow-x-auto px-5 py-4">
      <div class="w-max min-w-full font-mono text-[13px]/[1.65]">
        <p class="text-panel-muted">&gt; build</p>
        <p class="mt-3">
          <span class="text-panel-muted">←</span> Write src/parse.ts
        </p>
        <p class="text-panel-muted">Wrote file successfully.</p>
        <div class="border-signal mt-3 border-l-2 pl-3">
          <p class="text-signal">
            Ultracite fixed what it could. Fix these, then re-read the file
            before editing it again:
          </p>
          <p class="text-panel-foreground whitespace-pre">
            src/parse.ts:1:30: error typescript(no-explicit-any): Unexpected
            `any`. Specify a different type.{" "}
            <span class="text-panel-muted">
              help: Use `unknown` instead, this will force you to explicitly,
              and safely, assert the type is correct.
            </span>
          </p>
          <p class="text-panel-muted">
            Finished in 31ms on 1 files using 10 threads.
          </p>
        </div>
        <p class="mt-4">
          <span class="text-panel-muted">←</span> Edit src/parse.ts
        </p>
        <p class="text-panel-muted">@@ -1,4 +1,4 @@</p>
        <p class="whitespace-pre text-[#ff8a80]">
          -export const parse = (input: any) =&gt; {"{"}
        </p>
        <p class="text-ok whitespace-pre">
          +export const parse = (input: string): unknown =&gt; {"{"}
        </p>
        <p class="text-panel-muted whitespace-pre">
          {"   const value = JSON.parse(input);"}
        </p>
        <p class="text-panel-muted whitespace-pre">{"   return value;"}</p>
        <p class="text-panel-muted whitespace-pre">{" };"}</p>
        <p class="text-panel-foreground mt-4">Done.</p>
      </div>
    </div>
  </figure>
  <ol class="flex flex-col gap-2 sm:gap-4 lg:col-span-4" role="list">
    {steps.map((step, index) => (
      <li class="rounded-blume border-border bg-code flex flex-1 flex-col gap-2 border p-5 sm:p-6">
        <p class="text-accent font-mono text-xs/5 tracking-wider uppercase">
          {index + 1}
        </p>
        <p class="text-lg/6 font-medium tracking-[-0.01em]">{step.title}</p>
        <p class="text-muted-foreground text-[15px]/6 text-pretty">
          <RichText text={step.body} />
        </p>
      </li>
    ))}
  </ol>
</div>
