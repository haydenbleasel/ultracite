---
import BeforeAfter from "../before-after.astro";

// A component as an agent might write it, and Oxfmt 0.72.0's output for it
// under ultracite/oxfmt (run for real; regenerate when the config changes).
const before = `import { cn } from '@/lib/utils'
import { Slot } from '@radix-ui/react-slot'
import type { ReactNode } from 'react'

export function Button({ asChild, children }: { asChild?: boolean, children: ReactNode }) {
  const Comp = asChild ? Slot : 'button'
  return <Comp className={cn('text-sm px-4 bg-primary hover:bg-primary/90 rounded-md h-10 font-medium')}>{children}</Comp>
}`;

const after = `import { Slot } from "@radix-ui/react-slot";
import type { ReactNode } from "react";

import { cn } from "@/lib/utils";

export function Button({
  asChild,
  children,
}: {
  asChild?: boolean;
  children: ReactNode;
}) {
  const Comp = asChild ? Slot : "button";
  return (
    <Comp
      className={cn(
        "bg-primary hover:bg-primary/90 h-10 rounded-md px-4 text-sm font-medium"
      )}
    >
      {children}
    </Comp>
  );
}`;

const sorts = [
  {
    description:
      "Packages first, then your own aliases, with a blank line between the groups and A–Z order inside each.",
    name: "sortImports",
  },
  {
    description:
      "Tailwind classes in the order Tailwind’s Prettier plugin uses, in className and in cn, clsx, cva, tw, twMerge, twJoin and tv calls.",
    name: "sortTailwindcss",
  },
  {
    description:
      "package.json keys in the conventional order, so a dependency an agent adds lands where a reviewer expects.",
    name: "sortPackageJson",
  },
];
---

<BeforeAfter
  after={after}
  before={before}
  id="ox-format"
  items={sorts}
  lang="tsx"
  path="components/button.tsx"
  title="Oxfmt, set up like the Prettier config you’d write"
>
  Oxfmt is built to match Prettier’s output. Ultracite keeps Prettier’s
  80-column width (Oxfmt defaults to 100), then turns on the sorting you’d
  otherwise install plugins for.
</BeforeAfter>
