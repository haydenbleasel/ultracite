---
import { agents } from "../../../lib/agents";
import Everywhere from "../everywhere.astro";

// Excerpts of what `ultracite init` writes for Oxlint
// (packages/cli/src/data/editors.ts and data/agents.ts), and lines from a real
// `ultracite check` run under a coding agent, where Oxlint prints its compact
// agent format (paths shortened from the benchmark fixture's src/copy-0/).
const vscodeSettings = `{
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "editor.formatOnSave": true
}`;

const zedSettings = `"oxlint": {
  "initialization_options": {
    "settings": {
      "run": "onType",
      "typeAware": true,
      "unusedDisableDirectives": "deny"
    }
  }
}`;

const diagnostics = [
  {
    location: "src/data.ts:20:14",
    message: "Use `Array#toSorted()` instead of `Array#sort()`.",
    rule: "unicorn(no-array-sort)",
  },
  {
    location: "src/store.ts:1:22",
    message:
      "Prefer using a top-level type-only import instead of inline type specifiers.",
    rule: "import(consistent-type-specifier-style)",
  },
  {
    location: "src/utils.ts:5:54",
    message: "Object keys should be sorted",
    rule: "eslint(sort-keys)",
  },
  {
    location: "src/utils.ts:59:14",
    message: "Unexpected `await` inside a loop.",
    rule: "eslint(no-await-in-loop)",
  },
  {
    location: "src/format.ts:42:6",
    message:
      "Prefer `String#replaceAll()` over `String#replace()` when using a regex with the global flag.",
    rule: "unicorn(prefer-string-replace-all)",
  },
];
---

<Everywhere
  cards={[
    {
      body: "The Oxc extension formats 16 languages, from TypeScript and CSS to YAML and Markdown, and applies Oxlint’s safe fixes when you save.",
      code: { lang: "jsonc", path: ".vscode/settings.json", text: vscodeSettings },
      eyebrow: "VS Code, Cursor, Devin Desktop",
      title: "Fix and format on save",
    },
    {
      body: "Oxlint’s language server checks each keystroke with the type-aware rules on, and a stale `oxlint-disable` comment is an error.",
      code: { lang: "jsonc", path: ".zed/settings.json", text: zedSettings },
      eyebrow: "Zed",
      title: "Lint as you type",
    },
    {
      body: `Oxlint notices when a coding agent runs it and prints one line per problem and no summary, to save tokens. \`init\` also writes the rules into \`AGENTS.md\`, which all ${agents.length} agents read.`,
      eyebrow: "Coding agents",
      title: "Output written for agents",
    },
  ]}
  id="ox-everywhere"
  title="The same rules in your editor, your agent and CI"
>
  <code class="font-mono text-base">init</code> points your editor at Oxlint
  and Oxfmt and tells your agents how to run them, so a file passes or fails
  the same way wherever it’s checked.
  <Fragment slot="terminal">
    <p class="mb-1 truncate text-panel-foreground">
      <span class="text-signal">$</span> npx ultracite check
    </p>
    {
      diagnostics.map((line) => (
        <p class="truncate">
          {line.location}: <span class="text-signal">error</span>{" "}
          <span class="text-panel-foreground">{line.rule}</span>:{" "}
          {line.message}
        </p>
      ))
    }
  </Fragment>
</Everywhere>
