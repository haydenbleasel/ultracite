---
import Coverage from "../coverage.astro";
import type { CoverageRow } from "../coverage.astro";

// A snapshot of Oxlint 1.87.0's catalog (`oxlint --rules --format=json`) and
// the rules ultracite/oxlint/core sets to "error" in Ultracite 8.0.0. The
// categories count rules in the eight plugins core enables (546 of the 871);
// the other plugins (react, jsx-a11y, nextjs, vue, jest, vitest) belong to the
// framework presets. Re-derive both when either version moves.
const catalogSize = 871;
const defaultCount = 111;
const coreCount = 474;
const typeAwareCount = 56;

const categories: CoverageRow[] = [
  {
    available: 125,
    defaults: 111,
    description: "Code that’s outright wrong or useless",
    enabled: 125,
    name: "Correctness",
  },
  {
    available: 50,
    defaults: 0,
    description: "Code that’s most likely wrong",
    enabled: 47,
    name: "Suspicious",
  },
  {
    available: 118,
    defaults: 0,
    description: "Stricter checks that can flag code that works",
    enabled: 105,
    name: "Pedantic",
  },
  {
    available: 7,
    defaults: 0,
    description: "Code that could run faster",
    enabled: 6,
    name: "Perf",
  },
  {
    available: 156,
    defaults: 0,
    description: "Code with a more idiomatic form",
    enabled: 131,
    name: "Style",
  },
  {
    available: 80,
    defaults: 0,
    description: "Bans on language and library features",
    enabled: 59,
    name: "Restriction",
  },
  {
    available: 10,
    defaults: 0,
    description: "Rules still in development",
    enabled: 1,
    name: "Nursery",
  },
];

const plugins = [
  { label: "eslint", value: "166" },
  { label: "unicorn", value: "127" },
  { label: "typescript", value: "102" },
  { label: "oxc", value: "23" },
  { label: "jsdoc", value: "19" },
  { label: "import", value: "16" },
  { label: "promise", value: "13" },
  { label: "node", value: "8" },
];
---

<Coverage
  caption="Oxlint 1.87.0 and Ultracite 8.0.0. Categories count the 546 rules in the eight plugins the core preset enables, drawn to one scale; the React, Next.js, Vue, Jest and Vitest presets turn on rules from the other plugins."
  id="ox-rules"
  notes={[
    {
      body: `All ${coreCount} are set to \`error\`. An agent takes a zero exit code as done, and a warning doesn’t change it, so a warning is a problem nobody fixes.`,
      title: "Errors, never warnings",
    },
    {
      body: "Rules like `no-floating-promises` and `no-misused-promises` need type information. They run once `init --type-aware` turns on Oxlint’s type-aware mode, on its typescript‑go backend.",
      title: `${typeAwareCount} rules that read your types`,
    },
  ]}
  rows={categories}
  stats={[
    { label: "Rules in Oxlint 1.87", value: String(catalogSize) },
    {
      label: "On by default, all of them correctness rules",
      value: String(defaultCount),
    },
    {
      accent: true,
      label: "On in Ultracite’s core preset, before any framework rules",
      value: String(coreCount),
    },
  ]}
  tiles={plugins}
  title={`${defaultCount} rules by default. ${coreCount} with Ultracite.`}
>
  Out of the box, Oxlint only runs correctness rules: code that is definitely
  broken. Ultracite also turns on the suspicious, pedantic, style and
  restriction rules that catch what agents get wrong, like loose types,
  floating promises and nested ternaries.
</Coverage>
