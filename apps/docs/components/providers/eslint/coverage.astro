---
import Coverage from "../coverage.astro";
import type { CoverageRow } from "../coverage.astro";

// ESLint 10.12.0 and the plugins ultracite/eslint/core loads, against
// Ultracite 8.0.0. `available` counts each one's rules that aren't
// deprecated; `defaults` counts the rules in its own recommended config
// (typescript-eslint's `recommended`) that core keeps on; `enabled` counts the
// rules `eslint --print-config` reports on for a TypeScript file. Not drawn:
// unused-imports and compat, one rule each. Re-derive when a version moves.
//
// Type information: ultracite/eslint/type-aware turns on 62 typescript-eslint
// rules (replacing five of ESLint's) and the 37 SonarJS rules and one Unicorn
// rule that register no listeners without a TypeScript program. It also gives
// that program to the 32 SonarJS rules in core that use types when there are
// some (all marked `requiresTypeChecking` by their plugins).
const catalogSize = 1190;
const recommendedCount = 726;
const coreCount = 918;
const typedPresetCount = 100;
const typedCoreCount = 32;

const plugins: CoverageRow[] = [
  {
    available: 374,
    defaults: 320,
    description: "Modern, idiomatic JavaScript",
    enabled: 346,
    mono: true,
    name: "unicorn",
  },
  {
    available: 282,
    defaults: 200,
    description: "Bugs and code smells, from SonarQube",
    enabled: 234,
    mono: true,
    name: "sonarjs",
  },
  {
    available: 199,
    defaults: 59,
    description: "ESLint’s own rules",
    enabled: 164,
    mono: true,
    name: "eslint",
  },
  {
    available: 127,
    defaults: 19,
    description: "TypeScript, with 62 more in type-aware",
    enabled: 57,
    mono: true,
    name: "@typescript-eslint",
  },
  {
    available: 78,
    defaults: 16,
    description: "JSDoc comments",
    enabled: 19,
    mono: true,
    name: "jsdoc",
  },
  {
    available: 46,
    defaults: 7,
    description: "Imports and exports",
    enabled: 28,
    mono: true,
    name: "import-x",
  },
  {
    available: 43,
    defaults: 8,
    description: "Node.js modules and APIs",
    enabled: 33,
    mono: true,
    name: "n",
  },
  {
    available: 24,
    defaults: 4,
    description: "GitHub’s own conventions",
    enabled: 21,
    mono: true,
    name: "github",
  },
  {
    available: 17,
    defaults: 8,
    description: "Promises",
    enabled: 14,
    mono: true,
    name: "promise",
  },
];
---

<Coverage
  caption="ESLint 10.12.0 and Ultracite 8.0.0, counted with `eslint --print-config` on a TypeScript file. Plugins are drawn to one scale. Not drawn: `unused-imports/no-unused-imports` and `compat/compat`, one rule each."
  defaultsLabel="In the plugin’s recommended config"
  id="es-rules"
  notes={[
    {
      body: `All ${coreCount} are errors, because an agent takes a zero exit code as done, and a warning doesn’t change it. That includes \`compat/compat\`, which flags browser APIs your browserslist targets don’t support, or Baseline’s when you set none.`,
      title: "Errors, never warnings",
    },
    {
      body: `Core works from the syntax alone, without a \`tsconfig.json\`. The \`type-aware\` preset adds ${typedPresetCount} typescript-eslint, SonarJS and Unicorn rules that need TypeScript’s type checker, such as \`no-floating-promises\`, and hands it to ${typedCoreCount} SonarJS rules in core that use it when it’s there. It’s opt-in, with \`init --type-aware\`.`,
      title: `${typedPresetCount + typedCoreCount} rules that read your types`,
    },
  ]}
  rows={plugins}
  stats={[
    {
      label: "Rules in ESLint 10 and the eight plugins drawn here",
      value: catalogSize.toLocaleString("en-US"),
    },
    {
      label: "In their recommended configs, if you set each one up yourself",
      value: String(recommendedCount),
    },
    {
      accent: true,
      label: "On in Ultracite’s core preset, before any framework rules",
      value: coreCount.toLocaleString("en-US"),
    },
  ]}
  title={`${recommendedCount} rules recommended. ${coreCount.toLocaleString("en-US")} with Ultracite.`}
>
  ESLint runs nothing until you configure it, and every plugin’s recommended
  config is a separate thing to install and keep up. Ultracite’s core preset
  turns on most of the rules in ten plugins, and an opt-in preset adds the
  TypeScript rules that need your types.
</Coverage>
