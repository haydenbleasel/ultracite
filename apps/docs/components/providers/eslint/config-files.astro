---
// The three files `ultracite init --linter eslint` writes for a React and
// Next.js app (rendered by lib/providers.ts, as on the homepage). Counts are
// rules `eslint --print-config` reports on with ESLint 10.12.0 and Ultracite
// 8.0.0: core on a TypeScript file, then the rules each framework preset
// turns on.
import { providers } from "../../../lib/providers";
import AnnotatedCode from "../../landing/annotated-code.astro";

const PRESETS = ["core", "react", "next"];

const ruleCounts = new Map([
  ["core", 918],
  ["next", 47],
  ["react", 549],
]);

let totalRules = 0;

for (const count of ruleCounts.values()) {
  totalRules += count;
}

const formatCount = (count: number): string => count.toLocaleString("en-US");

const eslint = providers.find((provider) => provider.id === "eslint");
const [lintFile, prettierFile, stylelintFile] = eslint?.configFiles ?? [];
const lintCode = lintFile?.code(PRESETS) ?? "";
const prettierCode = prettierFile?.code(PRESETS) ?? "";
const stylelintCode = stylelintFile?.code(PRESETS) ?? "";

// The import line of each preset gets its rule count.
const lintNotes = new Map(
  lintCode.split("\n").flatMap((line, index): [number, string][] => {
    const preset = PRESETS.find((name) =>
      line.includes(`"ultracite/eslint/${name}"`)
    );

    const count = preset ? ruleCounts.get(preset) : undefined;

    return count ? [[index, `${formatCount(count)} rules`]] : [];
  })
);

// What each line of the Prettier and Stylelint configs brings in
// (packages/cli/config/prettier and config/stylelint).
const noteFor = (code: string, notes: [string, string][]) =>
  new Map(
    code.split("\n").flatMap((line, index): [number, string][] => {
      const match = notes.find(([needle]) => line.includes(needle));

      return match ? [[index, match[1]]] : [];
    })
  );

const prettierNotes = noteFor(prettierCode, [
  ["...config", "80 columns, double quotes"],
]);

const stylelintNotes = noteFor(stylelintCode, [
  ["ultracite/stylelint", "standard + property order"],
]);
---

<div class="grid gap-2 sm:gap-4 lg:grid-cols-12">
  <AnnotatedCode
    class="lp-code-fill lg:col-span-7"
    code={lintCode}
    lang={lintFile?.lang ?? "javascript"}
    meta={`${formatCount(totalRules)} rules`}
    notes={lintNotes}
    title={lintFile?.name ?? "eslint.config.mjs"}
  />
  <div class="flex min-w-0 flex-col gap-2 sm:gap-4 lg:col-span-5">
    <AnnotatedCode
      code={prettierCode}
      lang={prettierFile?.lang ?? "javascript"}
      notes={prettierNotes}
      title={prettierFile?.name ?? "prettier.config.mjs"}
    />
    <AnnotatedCode
      code={stylelintCode}
      lang={stylelintFile?.lang ?? "javascript"}
      notes={stylelintNotes}
      title={stylelintFile?.name ?? "stylelint.config.mjs"}
    />
  </div>
</div>
