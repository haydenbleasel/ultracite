---
import { NEW_TAB_HINT_ID } from "blume/core/new-tab.ts";

import SectionHeading from "../../home/section-heading.astro";

// The three rules ultracite/biome/core gives a "safe" fix that Biome marks
// unsafe (packages/cli/config/biome/core), and the Biome flag the agent hook
// adds (biomeHookArgs in packages/cli/src/hooks.ts, since 7.3.0).
const promoted = [
  {
    description: "Deletes imports nothing in the file uses",
    name: "noUnusedImports",
  },
  {
    description: "Adds braces to a one-line if, else, for or while body",
    name: "useBlockStatements",
  },
  {
    description: "Sorts Tailwind classes in class names and cn() calls",
    name: "useSortedClasses",
  },
];
---

<section aria-labelledby="bi-agents" class="border-border border-b">
  <div class="hp-frame border-border mx-auto max-w-7xl border-x">
    <SectionHeading
      id="bi-agents"
      title="Safe fixes, tuned for agents that edit in steps"
    >
      Biome applies only its safe fixes unless you pass{" "}
      <code class="font-mono text-base whitespace-nowrap">--unsafe</code>.
      Ultracite makes three more safe so they run on save, and its agent hook
      holds one of them back.
    </SectionHeading>
    <div class="border-border bg-border grid gap-px border-t bg-clip-padding lg:grid-cols-2">
      <div class="bg-background flex flex-col">
        <div class="border-border flex items-center justify-between gap-4 border-b px-4 py-4 sm:px-6 lg:px-10">
          <h3 class="text-lg/7 font-medium">
            Unsafe in Biome, safe in Ultracite
          </h3>
          <span class="text-muted-foreground font-mono text-xs/5 tracking-wider uppercase">
            Applied by fix
          </span>
        </div>
        <ul class="divide-border flex flex-col divide-y" role="list">
          {promoted.map((rule) => (
            <li class="flex flex-col gap-1 px-4 py-5 sm:px-6 lg:px-10">
              <code class="font-mono text-sm/6">{rule.name}</code>
              <span class="text-muted-foreground text-[15px]/6 text-pretty">
                {rule.description}
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-background flex flex-col">
        <div class="hatch border-border flex items-center justify-between gap-4 border-b px-4 py-4 sm:px-6 lg:px-10">
          <h3 class="text-lg/7 font-medium">Skipped by the agent hook</h3>
          <span class="text-muted-foreground font-mono text-xs/5 tracking-wider uppercase">
            Since 7.3.0
          </span>
        </div>
        <div class="flex flex-1 flex-col gap-4 px-4 py-8 sm:px-6 lg:px-10">
          <p class="text-muted-foreground max-w-[52ch] text-base/7 text-pretty">
            An agent adds an import in one edit and the code that uses it in the
            next. A hook that ran{" "}
            <code class="text-foreground font-mono text-sm">fix</code> between
            them deleted the import as unused, and the next edit broke. On
            Biome, the hook{" "}
            <code class="text-foreground font-mono text-sm">init</code> writes
            now runs:
          </p>
        </div>
        <div class="border-border mt-auto border-t px-4 py-5 sm:px-6 lg:px-10">
          <code class="text-muted-foreground block overflow-x-auto font-mono text-[13px]/6 whitespace-nowrap">
            <span class="text-accent">$</span> npx ultracite fix
            --skip=correctness/noUnusedImports --hook
          </code>
        </div>
      </div>
    </div>
    <div class="border-border border-t px-4 py-8 sm:px-6 lg:px-10">
      <p class="text-muted-foreground max-w-[80ch] text-base/7 text-pretty">
        <span class="text-foreground font-medium">Where it came from.</span> A
        Claude Code user reported the race in January 2026 (
        <a
          aria-describedby={NEW_TAB_HINT_ID}
          class="hover:text-foreground underline underline-offset-2"
          href="https://github.com/haydenbleasel/ultracite/issues/483"
          rel="noopener noreferrer"
          target="_blank"
        >
          #483
        </a>
        ). Unused imports are still removed when you save or run{" "}
        <code class="text-foreground font-mono text-sm">ultracite fix</code>{" "}
        yourself, and{" "}
        <code class="text-foreground font-mono text-sm">check</code> still fails
        on them.
      </p>
    </div>
  </div>
</section>
