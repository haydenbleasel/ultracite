---
// The biome.jsonc `ultracite init --linter biome` writes for a React and
// Next.js app (rendered by lib/providers.ts, as on the homepage), with the
// rules each preset turns on, and what the core preset sets besides rules.
// Counts are from `biome rage --linter` with Biome 2.6.3 and Ultracite
// 8.0.3: core alone, then each preset added (React sets 20 rules, 3 of which
// core already has on).
import { providers } from "../../../lib/providers";
import AnnotatedCode from "../../landing/annotated-code.astro";
import Terminal from "../../landing/terminal.astro";

const PRESETS = ["core", "react", "next"];

const ruleCounts = new Map([
  ["core", 351],
  ["next", 7],
  ["react", 17],
]);

let totalRules = 0;

for (const count of ruleCounts.values()) {
  totalRules += count;
}

const biome = providers.find((provider) => provider.id === "biome");
const [configFile] = biome?.configFiles ?? [];
const code = configFile?.code(PRESETS) ?? "";

// The line naming each preset gets its rule count.
const notes = new Map(
  code.split("\n").flatMap((line, index): [number, string][] => {
    const preset = PRESETS.find((name) =>
      line.includes(`"ultracite/biome/${name}"`)
    );

    const count = preset ? ruleCounts.get(preset) : undefined;

    return count ? [[index, `${count} rules`]] : [];
  })
);

// Settings from packages/cli/config/biome/core beyond the rules, as option
// and value.
const settings = [
  ["lineWidth", "80"],
  ["semicolons", '"always"'],
  ["trailingCommas", '"es5"'],
  ["formatWithErrors", "true"],
  ["organizeImports", '"on"'],
  ["useTailwindSortedClasses", '"error"'],
];
---

<div class="grid gap-2 sm:gap-4 lg:grid-cols-12">
  <AnnotatedCode
    class="lp-code-attached lg:col-span-7"
    code={code}
    lang={configFile?.lang ?? "json"}
    meta={`${totalRules} rules, all errors`}
    notes={notes}
    title={configFile?.name ?? "biome.jsonc"}
  >
    {/* The divider color is translucent, so the grid sits on the code
        background rather than showing the slab through its gaps. */}
    <div class="rounded-b-blume border-border bg-code overflow-hidden border border-t-0">
      <dl class="bg-border grid grid-cols-2 gap-px font-mono text-xs/5 sm:grid-cols-3">
        {settings.map(([key, value]) => (
          <div class="bg-code flex flex-col gap-0.5 px-4 py-2.5">
            <dt class="text-muted-foreground">{key}</dt>
            <dd class="text-foreground">{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </AnnotatedCode>
  {/* `ultracite fix` on the repo's benchmark fixture, as Biome 2.5.15 printed
      it: one diagnostic in full, the other by its header, then the summary. */}
  <Terminal class="lg:col-span-5">
    <p class="text-panel-foreground mb-3 truncate">
      <span class="text-signal">$</span> npx ultracite fix
    </p>
    <p class="text-panel-foreground truncate">
      src/component.tsx:42:27 lint/performance/noJsxPropsBind
    </p>
    <p class="mt-1 text-pretty">
      <span class="text-signal">×</span> This function will be recreated on
      every render. Pass stable function references as props to avoid
      unnecessary rerenders.
    </p>
    <pre class="mt-2 overflow-hidden font-mono text-[13px]/[1.55]"><span class="text-signal">&gt;</span> 42 │   onChange={"{"}() =&gt; onToggle(task.id){"}"}
     │             <span class="text-signal">^^^^^^^^^^^^^^^^^^^^^^^</span></pre>
    <p class="text-panel-foreground mt-3 truncate">
      src/utils.ts:62:14 lint/performance/noAwaitInLoops
    </p>
    <p class="mt-3">Checked 7 files in 7ms. Fixed 6 files.</p>
    <p>Found 2 errors.</p>
  </Terminal>
</div>
