---
import Coverage from "../coverage.astro";
import type { CoverageRow } from "../coverage.astro";

// Biome 2.6.3's catalog (its configuration schema, without each group's
// `recommended` and `preset` keys, with `biome explain` for each rule's fix)
// against the rules on in Ultracite 8.0.3, counted with `biome rage --linter`:
// once with an empty config in a project with no framework dependencies, once
// with ultracite/biome/core. `defaults` counts the default rules core keeps;
// it turns off two, a11y/noAutofocus and complexity/noImportantStyles.
// Re-derive when either version moves.
const catalogSize = 640;
const defaultCount = 218;
const coreCount = 351;
const typeAwareCount = 6;

const groups: CoverageRow[] = [
  {
    available: 139,
    defaults: 75,
    description: "Code that’s likely wrong or useless",
    enabled: 105,
    name: "Suspicious",
  },
  {
    available: 112,
    defaults: 53,
    description: "Code that’s guaranteed to be wrong or useless",
    enabled: 60,
    name: "Correctness",
  },
  {
    available: 117,
    defaults: 12,
    description: "One consistent, idiomatic way to write it",
    enabled: 80,
    name: "Style",
  },
  {
    available: 57,
    defaults: 34,
    description: "Code that could be simpler",
    enabled: 50,
    name: "Complexity",
  },
  {
    available: 38,
    defaults: 36,
    description: "Accessibility problems in JSX and HTML",
    enabled: 37,
    name: "A11y",
  },
  {
    available: 16,
    defaults: 3,
    description: "Code that could run faster",
    enabled: 12,
    name: "Performance",
  },
  {
    available: 7,
    defaults: 3,
    description: "Potential security flaws",
    enabled: 6,
    name: "Security",
  },
  {
    available: 154,
    defaults: 0,
    description: "Rules still in development",
    enabled: 1,
    name: "Nursery",
  },
];

// What `ultracite fix` can do about each of the 351, by the fix kind Biome
// gives it. Ultracite makes three unsafe fixes safe: noUnusedImports,
// useBlockStatements and useTailwindSortedClasses.
const fixes = [
  { label: "safe fix, applied by fix", value: "74" },
  { label: "unsafe fix, with --unsafe", value: "79" },
  { label: "no fix, for the agent", value: "198" },
  { label: "type-aware, opt-in", value: String(typeAwareCount) },
];
---

<Coverage
  caption="Biome 2.6.3 and Ultracite 8.0.3, counted with `biome rage --linter`. Groups are drawn to one scale. Biome also turns on a framework’s recommended rules when it finds that framework in your dependencies; Ultracite’s framework presets set those rules explicitly."
  id="bi-rules"
  notes={[
    {
      body: `All ${coreCount} are set to \`error\`, including the recommended rules Ultracite keeps, because an agent takes a zero exit code as done and a warning doesn’t change it.`,
      title: "Errors, never warnings",
    },
    {
      body: "The `type-aware` preset adds rules like `noImportCycles`, `noUnresolvedImports` and `noDeprecatedImports`. They need Biome to scan your whole project first, so they’re opt-in: `init --type-aware` adds the preset.",
      title: `${typeAwareCount} rules that read your project`,
    },
  ]}
  rows={groups}
  stats={[
    { label: "Rules in Biome 2.6", value: String(catalogSize) },
    {
      label: "On by default, from Biome’s recommended set",
      value: String(defaultCount),
    },
    {
      accent: true,
      label: "On in Ultracite’s core preset, before any framework rules",
      value: String(coreCount),
    },
  ]}
  tiles={fixes}
  title={`${defaultCount} rules by default. ${coreCount} with Ultracite.`}
>
  Ultracite keeps all but two of Biome’s recommended rules, then turns on most
  of the style, complexity and performance rules Biome leaves off. They catch
  what agents get wrong: barrel files, nested ternaries, awaits inside loops and
  forEach where for…of would do.
</Coverage>
