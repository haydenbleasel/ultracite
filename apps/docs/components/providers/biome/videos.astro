---
import { NEW_TAB_HINT_ID } from "blume/core/new-tab.ts";

import SectionHeading from "../../home/section-heading.astro";

// Community walkthroughs of moving a real project from ESLint and Prettier to
// Ultracite's Biome preset, embedded the way Blume's YouTube component does.
const videos = [
  {
    channel: "Better Stack",
    channelUrl: "https://www.youtube.com/@betterstack",
    id: "lEkXbneUnWg",
    title:
      "The EASIEST Way To Switch From ESLint & Prettier to Biome — Ultracite",
  },
  {
    channel: "OrcDev",
    channelUrl: "https://www.youtube.com/@orcdev",
    id: "b_F4LaycQcE",
    title: "This New Tool Made Me Delete ESLint Without Regret",
  },
];
---

<section aria-labelledby="bi-videos" class="border-border border-b">
  <div class="hp-frame border-border mx-auto max-w-7xl border-x">
    <SectionHeading id="bi-videos" title="Watch the switch from ESLint">
      Two community walkthroughs of replacing ESLint and Prettier with
      Ultracite’s Biome preset in a real project.
    </SectionHeading>
    <ul
      class="border-border bg-muted/60 grid gap-2 border-t p-2 sm:gap-4 sm:p-6 md:grid-cols-2 lg:p-10"
      role="list"
    >
      {videos.map((video) => (
        <li class="rounded-blume border-border bg-code flex min-w-0 flex-col overflow-hidden border">
          <div class="bg-panel aspect-video w-full">
            <iframe
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              class="size-full"
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              src={`https://www.youtube-nocookie.com/embed/${video.id}`}
              title={video.title}
            />
          </div>
          <p class="border-border flex flex-col gap-1 border-t px-5 py-4">
            <span class="text-[15px]/6 font-medium text-pretty">
              {video.title}
            </span>
            <a
              aria-describedby={NEW_TAB_HINT_ID}
              class="text-muted-foreground hover:text-foreground w-fit text-sm/5 underline underline-offset-2"
              href={video.channelUrl}
              rel="noopener noreferrer"
              target="_blank"
            >
              {video.channel}
            </a>
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
