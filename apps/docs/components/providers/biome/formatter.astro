---
import BeforeAfter from "../before-after.astro";

// The component from the Oxlint page, and what `ultracite fix` made of it
// with Biome 2.6.4 under ultracite/biome/core and Ultracite 8.1.1 (run for real; regenerate when
// the config changes; re-run 2026-11-11 on Ultracite 8.2.0: unchanged). `items`
// names settings in packages/cli/config/biome/core: ten of its assist actions
// are on, and sorting object keys is not one of them. Biome 2.6 sorts Tailwind classes in Tailwind CSS v4's
// order, which gives this component the same order as Oxfmt.
const before = `import { cn } from '@/lib/utils'
import { Slot } from '@radix-ui/react-slot'
import type { ReactNode } from 'react'

export function Button({ asChild, children }: { asChild?: boolean, children: ReactNode }) {
  const Comp = asChild ? Slot : 'button'
  return <Comp className={cn('text-sm px-4 bg-primary hover:bg-primary/90 rounded-md h-10 font-medium')}>{children}</Comp>
}`;

const after = `import { Slot } from "@radix-ui/react-slot";
import type { ReactNode } from "react";
import { cn } from "@/lib/utils";

export function Button({
  asChild,
  children,
}: {
  asChild?: boolean;
  children: ReactNode;
}) {
  const Comp = asChild ? Slot : "button";
  return (
    <Comp
      className={cn(
        "bg-primary hover:bg-primary/90 h-10 rounded-md px-4 text-sm font-medium"
      )}
    >
      {children}
    </Comp>
  );
}`;

const items = [
  {
    description:
      "Imports by distance: packages first, then your `@/` aliases, then relative paths, A–Z within each.",
    name: "organizeImports",
  },
  {
    description:
      "Tailwind classes sorted in `class`, `className` and `cn`, `clsx`, `cva`, `tw`, `twMerge`, `twJoin` and `tv` calls, in Tailwind CSS v4’s order.",
    name: "useTailwindSortedClasses",
  },
  {
    description:
      "JSX attributes in order. Interface members, CSS properties and package.json fields each have a sorting action of their own. `check` fails on any that aren’t sorted.",
    name: "useSortedAttributes",
  },
  {
    description:
      "On, so a file with a syntax error still gets formatted. Biome leaves it off by default.",
    name: "formatWithErrors",
  },
];
---

<BeforeAfter
  after={after}
  before={before}
  id="bi-format"
  items={items}
  lang="tsx"
  path="components/button.tsx"
  title="Formatting and sorting from the same binary"
>
  Biome’s formatter is built to match Prettier’s output, and its assist actions
  sort code instead of just reporting it. Ultracite turns on ten of them, so the
  import order, class order and attribute order an agent writes never come up in
  review.
</BeforeAfter>
