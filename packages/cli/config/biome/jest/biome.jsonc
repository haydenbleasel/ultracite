{
  "root": false,
  "$schema": "../../../node_modules/@biomejs/biome/configuration_schema.json",
  "linter": {
    "rules": {
      "complexity": {
        "noExcessiveNestedTestSuites": "error"
      },
      "style": {
        "noDoneCallback": "error",
        // Matches consistent-test-it's defaults in the oxlint/ESLint configs.
        // Biome's default for top-level tests is it().
        "useConsistentTestIt": {
          "level": "error",
          "options": {
            "function": "test",
            "withinDescribe": "it"
          }
        },
        "useTestHooksInOrder": "error",
        "useTestHooksOnTop": "error"
      },
      "suspicious": {
        "noConditionalExpect": "error",
        "noDuplicateTestHooks": "error",
        "noExportsInTest": "error",
        "noFocusedTests": "error",
        "noIdenticalTestTitle": "error",
        "noMisplacedAssertion": "error",
        "noSkippedTests": "error",
        "useExpect": "error"
      }
    }
  },
  "overrides": [
    {
      // Jest injects its globals into test files without imports, so
      // noUndeclaredVariables reported every describe, it and expect. Mirrors
      // the ESLint jest preset's globals.jest.
      "includes": [
        "**/*.{test,spec}.{ts,tsx,js,jsx,mts,cts,mjs,cjs}",
        "**/__tests__/**/*"
      ],
      "javascript": {
        "globals": [
          "afterAll",
          "afterEach",
          "beforeAll",
          "beforeEach",
          "describe",
          "expect",
          "fit",
          "it",
          "jest",
          "test",
          "xdescribe",
          "xit",
          "xtest"
        ]
      }
    }
  ]
}
