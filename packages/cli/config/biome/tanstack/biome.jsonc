{
	"root": false,
	"$schema": "../../../node_modules/@biomejs/biome/configuration_schema.json",
	"overrides": [
		{
			"includes": ["**/routes/**/*.{tsx,ts}", "**/app/routes/**/*.{tsx,ts}"],
			"assist": {
				"actions": {
					"source": {
						// Route option types are order-sensitive: `head`/`component`
						// infer `loaderData` from properties declared before them, so
						// alphabetical sorting breaks type inference.
						"useSortedKeys": "off"
					}
				}
			},
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		}
	]
}
