{
	"root": false,
	"$schema": "../../../node_modules/@biomejs/biome/configuration_schema.json",
	"javascript": {
		"parser": {
			// Angular injects through parameter decorators (@Inject(),
			// @Optional()), which Biome otherwise rejects as a parse error
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"linter": {
		"rules": {
			"style": {
				// The fix turns the import of an injected class into `import type`,
				// and constructor injection needs the class at runtime
				"useImportType": "off"
			}
		}
	},
	"html": {
		"parser": {
			"interpolation": true
		}
	}
}
