{
  "name": "ultracite",
  "version": "8.3.1",
  "description": "The linter and formatter for agentic development.",
  "keywords": [
    "biome",
    "fixer",
    "formatter",
    "linter",
    "ultracite"
  ],
  "homepage": "https://www.ultracite.ai/",
  "bugs": {
    "url": "https://github.com/haydenbleasel/ultracite/issues"
  },
  "license": "MIT",
  "author": "Hayden Bleasel <hello@haydenbleasel.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haydenbleasel/ultracite.git"
  },
  "bin": {
    "ultracite": "dist/index.js"
  },
  "files": [
    "config",
    "dist",
    "skills",
    "README.md"
  ],
  "type": "module",
  "exports": {
    "./biome/*": "./config/biome/*/biome.jsonc",
    "./eslint/*": "./config/eslint/*/eslint.config.mjs",
    "./oxlint/*": {
      "types": "./config/oxlint/*/index.d.mts",
      "default": "./config/oxlint/*/index.mjs"
    },
    "./oxfmt": {
      "types": "./config/oxfmt/index.d.mts",
      "default": "./config/oxfmt/index.mjs"
    },
    "./prettier": "./config/prettier/prettier.config.mjs",
    "./stylelint": "./config/stylelint/stylelint.config.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "generate": "bun run scripts/generate-dts.ts",
    "prebuild": "bun run generate",
    "prepack": "bun run scripts/copy-skill.ts",
    "build": "bun check --no-script && bun run build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "bench": "bun run benchmarks/cli.bench.ts",
    "types": "bun check --no-script"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "cli-truncate": "^6.1.1",
    "commander": "^15.0.0",
    "deepmerge": "^4.3.1",
    "empathic": "^2.1.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "find-workspaces": "^0.3.1",
    "jsonc-parser": "^3.3.1",
    "log-update": "^8.0.0",
    "magicast": "^0.5.5",
    "npm-run-path": "^6.0.0",
    "nypm": "^0.6.10",
    "resolve.exports": "^2.0.3",
    "semver": "^7.8.5",
    "string-width": "^8.3.0",
    "which-command": "^0.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.8.0",
    "@angular-eslint/eslint-plugin-template": "^22.8.0",
    "@angular-eslint/template-parser": "^22.8.0",
    "@astrojs/compiler-rs": "^0.5.3",
    "@biomejs/biome": "2.6.8",
    "@darraghor/eslint-plugin-nestjs-typed": "^7.5.10",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@gdp-ts/core": "^0.1.0",
    "@interfere/landmines": "^0.1.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@react-native/eslint-plugin": "^0.88.1",
    "@shadcn/lint": "^0.2.5",
    "@tanstack/eslint-plugin-query": "^5.108.0",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@tanstack/eslint-plugin-start": "^0.1.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@types/semver": "^7.8.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript-eslint/utils": "^8.73.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-cypress": "^7.0.5",
    "eslint-plugin-drizzle": "^0.2.3",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jest": "^29.17.1",
    "eslint-plugin-jsdoc": "^65.4.12",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-qwik": "^1.20.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-doctor": "^0.9.23",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-native": "^5.0.0",
    "eslint-plugin-remix": "^1.1.1",
    "eslint-plugin-solid": "^0.20.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-tsdoc": "^0.5.4",
    "eslint-plugin-unicorn": "^80.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.12.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "oxlint-tsgolint": "^7.0.2007",
    "postcss-less": "^7.1.1",
    "postcss-scss": "^4.0.9",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.7",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@biomejs/biome": "^2.6.7",
    "eslint": "^10.9.0",
    "oxfmt": ">=0.71.0 <1",
    "oxlint": "^1.94.0",
    "prettier": "^3.5.3",
    "stylelint": "^18.0.0"
  },
  "peerDependenciesMeta": {
    "@biomejs/biome": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "packageManager": "bun@1.4.4"
}
