  "eslintComments": {
    "eslint.mjs: no-use-before-define": "`variables: false` skips a reference from inside a function to a variable declared later in an outer scope; functions that call each other have no order that satisfies the default. Matches oxlint.",
    "sonarjs.mjs: sonarjs/cognitive-complexity": "The same number as Biome's noExcessiveCognitiveComplexity limit, but the two score functions differently, so the limits aren't equivalent.",
    "unicorn.mjs: unicorn/no-nested-ternary": "Its fixer wraps the inner ternary in parentheses that Prettier strips, so every `fix` run ping-pongs. eslint-config-prettier turns it off for the same reason; the core `no-nested-ternary` still reports.",
    "unicorn.mjs: unicorn/no-useless-undefined": "Upstream already skips call arguments in TypeScript files, since a required `T | undefined` parameter needs an explicit `undefined` (#851). Matches oxlint, which skips them everywhere.",
    "unicorn.mjs: unicorn/prefer-minimal-ternary": "Also merge branches that differ only in the callee or a computed member, as in (test ? a : b)(value). Both options are off by default upstream, and prefer-ternary takes the same two.",
    "eslint.config.mjs: curly": "eslint-config-prettier disables these defensively, but they don't conflict with our Prettier settings and the oxlint config enforces them alongside oxfmt."
  },
  "biome": {
    "core": {
      "complexity/noUselessTernary": "error",
      "complexity/noExcessiveCognitiveComplexity": {
        "level": "error",
        "options": {
          "maxAllowedComplexity": 20
        }
      },
      "complexity/noExcessiveCognitiveComplexity (override [\"**__tests__*\"])": "off",
      "complexity/useSimplifiedLogicExpression": "error",
      "complexity/noUselessUndefinedInitialization": "error",
      "style/noNestedTernary": "error",
