# Regenerated by scripts/measure.cjs.
biome-input/

# The agents' raw output and session logs carry account details (emails, org and session
# ids). They're kept locally so measure.cjs can re-read them, but never committed.
results/*/runs/*/transcript.jsonl
results/*/runs/*/stdout.txt
results/*/runs/*/stderr.txt
# A multi-file subject's runs keep them per step (the import-cycles topic).
results/*/runs/*/step*/transcript.jsonl
results/*/runs/*/step*/stdout.txt
results/*/runs/*/step*/stderr.txt
# A run through Ultracite's retry loop keeps them per attempt (the accessibility and todo-comments
# topics).
results/*/runs/*/attempt*/transcript.jsonl
results/*/runs/*/attempt*/stdout.txt
results/*/runs/*/attempt*/stderr.txt
# Runs set aside before the final design (the accessibility topic's first runs, made before the
# run dir had a package.json).
results/*/superseded-runs/*/attempt*/transcript.jsonl
results/*/superseded-runs/*/attempt*/stdout.txt
results/*/superseded-runs/*/attempt*/stderr.txt

# Oxlint, Oxfmt and Biome configs generated by scripts/topics/security-rules.cjs, dead-code.cjs,
# import-cycles.cjs, accessibility.cjs and todo-comments.cjs.
# They import Ultracite's presets by absolute file URL, so they name this machine's paths.
lint-configs/
