# Regenerated by scripts/measure.cjs.
biome-input/

# The agents' raw output and session logs carry account details (emails, org and session
# ids). They're kept locally so measure.cjs can re-read them, but never committed.
results/*/runs/*/transcript.jsonl
results/*/runs/*/stdout.txt
results/*/runs/*/stderr.txt
# A multi-file subject's runs keep them per step (the import-cycles topic).
results/*/runs/*/step*/transcript.jsonl
results/*/runs/*/step*/stdout.txt
results/*/runs/*/step*/stderr.txt
# A run through Ultracite's retry loop keeps them per attempt (the accessibility, todo-comments,
# sort-keys, react-effects, length-limits, func-style and nested-ternaries topics).
results/*/runs/*/attempt*/transcript.jsonl
results/*/runs/*/attempt*/stdout.txt
results/*/runs/*/attempt*/stderr.txt
# Runs set aside before the final design (the accessibility topic's first runs, made before the
# run dir had a package.json), and later topics' pilots.
results/*/superseded-runs/*/attempt*/transcript.jsonl
results/*/superseded-runs/*/attempt*/stdout.txt
results/*/superseded-runs/*/attempt*/stderr.txt

# The prompt-revision topic keeps each borrowed topic's runs one folder deeper.
results/prompt-revision/*/runs/*/transcript.jsonl
results/prompt-revision/*/runs/*/stdout.txt
results/prompt-revision/*/runs/*/stderr.txt
results/prompt-revision/*/runs/*/attempt*/transcript.jsonl
results/prompt-revision/*/runs/*/attempt*/stdout.txt
results/prompt-revision/*/runs/*/attempt*/stderr.txt
# Round two's runs are one folder deeper again.
results/prompt-revision/round-2/*/runs/*/transcript.jsonl
results/prompt-revision/round-2/*/runs/*/stdout.txt
results/prompt-revision/round-2/*/runs/*/stderr.txt
results/prompt-revision/round-2/*/runs/*/attempt*/transcript.jsonl
results/prompt-revision/round-2/*/runs/*/attempt*/stdout.txt
results/prompt-revision/round-2/*/runs/*/attempt*/stderr.txt

# Oxlint, Oxfmt and Biome configs generated by scripts/topics/security-rules.cjs, dead-code.cjs,
# import-cycles.cjs, accessibility.cjs and todo-comments.cjs, the ESLint, Prettier and Stylelint
# configs sort-keys.cjs generates, and all of these from react-effects.cjs, length-limits.cjs,
# func-style.cjs and nested-ternaries.cjs.
# They import Ultracite's presets by absolute file URL, so they name this machine's paths.
lint-configs/
