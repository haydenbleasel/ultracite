+function commonIndentationLength(
+  a: string,
+  aLength: number,
+  b: string,
+  bLength: number
+): number {
+  let i: number;
+  for (i = 0; i < aLength && i < bLength; i++) {
+    const aCharCode = a.charCodeAt(i);
+    const bCharCode = b.charCodeAt(i);
+    if (aCharCode !== bCharCode) {
+      break;
+    }
+  }
+  return i;
+}
+
+function countIndentation(
+  text: string,
+  start: number,
+  end: number
+): [number, number] {
+  let spacesCount = 0;
+  let tabsCount = 0;
+  for (let j = start; j < end; j++) {
+    if (text.charCodeAt(j) === CharCode.Space) {
+      spacesCount++;
+    } else {
+      tabsCount++;
+    }
+  }
+  return [spacesCount, tabsCount];
+}
+
+function looksLikeAlignment(
+  a: string,
+  b: string,
+  difference: number,
+  bSpacesCnt: number
+): boolean {
+  // This looks like an alignment desire: e.g.
+  // const a = b + c,
+  //       d = b - c;
+  return (
+    difference > 0 &&
+    bSpacesCnt - 1 >= 0 &&
+    bSpacesCnt - 1 < a.length &&
+    bSpacesCnt < b.length &&
+    b.charCodeAt(bSpacesCnt) !== CharCode.Space &&
+    a.charCodeAt(bSpacesCnt - 1) === CharCode.Space &&
+    a.charCodeAt(a.length - 1) === CharCode.Comma
+  );
+}
