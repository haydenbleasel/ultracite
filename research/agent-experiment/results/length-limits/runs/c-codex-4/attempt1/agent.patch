+function countIndentation(
+  text: string,
+  start: number,
+  end: number
+): [number, number] {
+  let spacesCount = 0;
+  let tabsCount = 0;
+  for (let j = start; j < end; j++) {
+    const charCode = text.charCodeAt(j);
+    if (charCode === CharCode.Space) {
+      spacesCount++;
+    } else {
+      tabsCount++;
+    }
+  }
+  return [spacesCount, tabsCount];
+}
+
+function setSpacesDiffWithAlignment(
+  a: string,
+  b: string,
+  bSpacesCnt: number,
+  spacesDiff: number,
+  result: SpacesDiffResult
+): void {
+  // check if the indentation difference might be caused by alignment reasons
+  // sometime folks like to align their code, but this should not be used as a hint
+  result.spacesDiff = spacesDiff;
+
+  if (
+    spacesDiff > 0 &&
+    bSpacesCnt - 1 >= 0 &&
+    bSpacesCnt - 1 < a.length &&
+    bSpacesCnt < b.length
+  ) {
+    if (
+      b.charCodeAt(bSpacesCnt) !== CharCode.Space &&
+      a.charCodeAt(bSpacesCnt - 1) === CharCode.Space
+    ) {
+      if (a.charCodeAt(a.length - 1) === CharCode.Comma) {
+        // This looks like an alignment desire: e.g.
+        // const a = b + c,
+        //       d = b - c;
+        result.looksLikeAlignment = true;
+      }
+    }
+  }
+}
