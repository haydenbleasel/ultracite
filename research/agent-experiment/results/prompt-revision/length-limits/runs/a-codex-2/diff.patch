+const createClientConfigValueReplacer =
+  async function createClientConfigValueReplacer(
+    config: ResolvedConfig
+  ): Promise<(code: string) => string> {
+    const resolvedServerHostname = (await resolveHostname(config.server.host))
+      .name;
+    const values = getClientConfigValues(config, resolvedServerHostname);
+
+    const modeReplacement = escapeReplacement(config.mode);
+    const baseReplacement = escapeReplacement(values.devBase);
+    const serverHostReplacement = escapeReplacement(values.serverHost);
+    const hmrProtocolReplacement = escapeReplacement(values.protocol);
+    const hmrHostnameReplacement = escapeReplacement(values.host);
+    const hmrPortReplacement = escapeReplacement(values.port);
+    const hmrDirectTargetReplacement = escapeReplacement(values.directTarget);
+    const hmrBaseReplacement = escapeReplacement(values.hmrBase);
+    const hmrTimeoutReplacement = escapeReplacement(values.timeout);
+    const hmrEnableOverlayReplacement = escapeReplacement(values.overlay);
+    const hmrConfigNameReplacement = escapeReplacement(values.hmrConfigName);
+    const hmrPartialAcceptReplacement = escapeReplacement(
+      config.experimental.hmrPartialAccept
+    );
+    const wsTokenReplacement = escapeReplacement(config.webSocketToken);
+    const serverForwardConsoleReplacement = escapeReplacement(
+      config.server.forwardConsole as any
+    );
+
+    return (code) =>
+      code
+        .replace(`__MODE__`, modeReplacement)
+        .replaceAll("__BASE__", baseReplacement)
+        .replace(`__SERVER_HOST__`, serverHostReplacement)
+        .replace(`__HMR_PROTOCOL__`, hmrProtocolReplacement)
+        .replace(`__HMR_HOSTNAME__`, hmrHostnameReplacement)
+        .replace(`__HMR_PORT__`, hmrPortReplacement)
+        .replace(`__HMR_DIRECT_TARGET__`, hmrDirectTargetReplacement)
+        .replace(`__HMR_BASE__`, hmrBaseReplacement)
+        .replace(`__HMR_TIMEOUT__`, hmrTimeoutReplacement)
+        .replace(`__HMR_ENABLE_OVERLAY__`, hmrEnableOverlayReplacement)
+        .replace(`__HMR_CONFIG_NAME__`, hmrConfigNameReplacement)
+        .replace(`__HMR_PARTIAL_ACCEPT__`, hmrPartialAcceptReplacement)
+        .replace(`__WS_TOKEN__`, wsTokenReplacement)
+        .replace(`__SERVER_FORWARD_CONSOLE__`, serverForwardConsoleReplacement);
+  };
