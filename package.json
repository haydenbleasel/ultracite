{
  "name": "ultracite-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The linter and formatter for agentic development.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "types": "turbo types",
    "check": "bun ./packages/cli/src/index.ts check",
    "fix": "bun ./packages/cli/src/index.ts fix",
    "validate:configs": "bun ./scripts/validate-configs.ts",
    "benchmark": "bun ./benchmark/index.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "turbo run build && changeset publish",
    "bump-deps": "npx npm-check-updates --deep -u -x \"oxfmt, oxlint, @biomejs/biome, *eslint*, *prettier*, *stylelint*\" && bun install",
    "bump-tools": "npx npm-check-updates --deep -u --filter \"oxfmt, oxlint, @biomejs/biome, *eslint*, *prettier*, *stylelint*\" && bun install",
    "prepare": "husky"
  },
  "dependencies": {
    "empathic": "^2.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@gdp-ts/core": "^0.1.0",
    "@shadcn/lint": "^0.2.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.3",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "concurrently": "^10.0.5",
    "eslint-plugin-github": "6.1.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "mitata": "^1.0.34",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-plugin-react-doctor": "^0.9.16",
    "turbo": "^2.11.5",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@typescript-eslint/utils": "^8.62.1"
  },
  "packageManager": "bun@1.4.2",
  "patchedDependencies": {
    "oxfmt@0.71.0": "patches/oxfmt@0.71.0.patch"
  }
}
